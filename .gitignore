# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Alternate build dir used by NEXT_DIST_DIR (e.g. a demo preview run alongside
# `npm run dev`). Ignored so Tailwind's source scan skips its compiled chunks.
/.next-demo/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local Claude settings (machine-specific)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated via `npm run db:generate`)
/src/generated

# playwright
/test-results
/playwright-report

.vercel
.env*
