# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Alternate build dir used by NEXT_DIST_DIR (e.g. a demo preview run alongside
# `npm run dev`). Ignored so Tailwind's source scan skips its compiled chunks.
/.next-demo/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local Claude settings (machine-specific)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated via `npm run db:generate`)
/src/generated

# playwright
/test-results
/playwright-report

# ── Mobile / Capacitor ────────────────────────────────────────────────
# Vite output for the native app. This is Capacitor's webDir; CI rebuilds it
# before `cap sync`, so it must never be committed.
/mobile/dist/

# Simulator/CI runtime output. Screenshots and logs are CI artifacts, never
# repository content; DerivedData and the SPM clone cache are build caches.
/artifacts/
/.spm-cache/

# Apple signing material. These live on your machine and, transiently, on the
# macOS runner — never in git. `scripts/verify-no-signing-material.mjs` fails
# CI if any of them is tracked anyway.
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8

# The native iOS project IS tracked — do NOT ignore /ios. Its generated and
# machine-local artifacts (build output, synced web assets, DerivedData, the
# generated capacitor.config.json) are excluded by `ios/.gitignore`, which
# Capacitor owns and regenerates. Keep that as the single source of truth.
*.xcuserstate

.vercel
.env*

# Staging environment. `.env*` is already ignored above, but these are named
# explicitly because they are the files most likely to be created by hand in a
# hurry and the consequence of committing them is a leaked service-role key.
/.env.staging
/.env.staging.ids
