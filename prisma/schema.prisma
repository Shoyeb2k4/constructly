// Constructly — Prisma schema
// Module 0: tenant + auth foundation. Module 1: project management.
// Full target model documented in docs/database.md. Tenant isolation is
// enforced by Postgres RLS — see prisma/rls.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PROJECT_MANAGER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRASTRUCTURE
  RENOVATION
  INTERIOR_FITOUT
}

enum ProjectStage {
  CREATED
  PLANNING
  ESTIMATION
  PROCUREMENT
  CONSTRUCTION
  QUALITY_INSPECTION
  COMPLETION
  HANDOVER
  CLOSED
}

enum DocumentCategory {
  DRAWING
  PDF
  PHOTO
  CONTRACT
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

/// A tenant. Every domain row carries companyId.
model Company {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  gstin    String?
  /// { poApprovalRequired: boolean, currency: "INR", ... }
  settings Json    @default("{\"poApprovalRequired\": false, \"currency\": \"INR\"}")

  // ── Company profile (white-labeling). All nullable — companies without
  //    branding fall back to Constructly defaults (see features/branding). ──
  legalName   String? @map("legal_name")
  pan         String?
  cin         String?
  addressLine String? @map("address_line")
  city        String?
  state       String?
  country     String? @default("India")
  pincode     String?
  phone       String?
  email       String?
  website     String?

  // ── Branding assets: Supabase Storage object paths ("{companyId}/…"). ──
  logoPath       String? @map("logo_path")
  squareLogoPath String? @map("square_logo_path")
  darkLogoPath   String? @map("dark_logo_path")
  lightLogoPath  String? @map("light_logo_path")
  faviconPath    String? @map("favicon_path")
  stampPath      String? @map("stamp_path")
  /// { primary, secondary, accent, success, warning, danger } hex strings.
  brandColors    Json?   @map("brand_colors")

  /// Retention window (days) after which a soft-deleted project becomes
  /// ELIGIBLE for admin/scheduled permanent cleanup. null = keep indefinitely
  /// (never auto-eligible). Nothing is ever hard-deleted automatically; this
  /// only marks eligibility for a reviewed, admin-only purge. See
  /// features/projects/retention.ts.
  projectRetentionDays Int? @map("project_retention_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                        User[]
  roles                        CompanyRole[]
  userRoles                    UserRole[]
  invitations                  Invitation[]
  projects                     Project[]
  activity                     ActivityLog[]
  contractors                  Contractor[]
  contractorLedger             ContractorLedgerEntry[]
  contractorSettlements        ContractorSettlement[]
  settlementBreakdowns         ContractorSettlementBreakdown[]
  labourCategories             LabourCategory[]
  labourSubcategories          LabourSubcategory[]
  labourAttendance             LabourAttendance[]
  vendors                      Vendor[]
  materials                    Material[]
  vendorMaterials              VendorMaterial[]
  purchaseOrders               PurchaseOrder[]
  vendorPayments               VendorPayment[]
  vendorDocuments              VendorDocument[]
  goodsReceipts                GoodsReceipt[]
  contractorAssignments        ProjectContractorAssignment[]
  projectContractors           ProjectContractor[]
  projectContractorLabourRates ProjectContractorLabourRate[]
  contractorContracts          ContractorContract[]
  contractorContractPayments   ContractorContractPayment[]
  contractScopeItems           ContractScopeItem[]
  contractScopeRateRevisions   ContractScopeRateRevision[]
  contractMilestones           ContractMilestone[]
  contractAmendments           ContractAmendment[]
  pclrRateRevisions            ProjectContractorLabourRateRevision[]

  @@map("companies")
}

/// Application user. `id` mirrors the Supabase auth user id.
model User {
  id            String     @id @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  email         String     @unique
  fullName      String     @map("full_name")
  /// Legacy role enum — still authoritative for authorization in Phase 1. The
  /// RBAC layer (companyRole) runs alongside it until the Phase 2 enforcement
  /// swap. Do NOT drop this column until every check reads permissions instead.
  role          Role       @default(PROJECT_MANAGER)
  status        UserStatus @default(ACTIVE)
  /// RBAC: the data-driven company role assigned to this user (nullable during
  /// migration; the session falls back to `role` when unset).
  companyRoleId String?    @map("role_id") @db.Uuid

  // ── Personal profile (all nullable; sensible defaults applied in app). ──
  designation   String?
  phone         String?
  photoPath     String? @map("photo_path")
  signaturePath String? @map("signature_path")
  theme         String? @default("system")
  language      String? @default("en")
  timezone      String? @default("Asia/Kolkata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdProjects        Project[]         @relation("ProjectCreatedBy")
  managedProjects        Project[]         @relation("ProjectManager")
  deletedProjects        Project[]         @relation("ProjectDeletedBy")
  favorites              ProjectFavorite[]
  activity               ActivityLog[]
  createdPurchaseOrders  PurchaseOrder[]   @relation("POCreatedBy")
  approvedPurchaseOrders PurchaseOrder[]   @relation("POApprovedBy")
  vendorFavorites        VendorFavorite[]
  vendorPayments         VendorPayment[]   @relation("PaymentCreatedBy")
  goodsReceipts          GoodsReceipt[]    @relation("GoodsReceiptCreatedBy")
  sentInvitations        Invitation[]      @relation("InvitationInvitedBy")
  companyRole            CompanyRole?      @relation("UserCompanyRole", fields: [companyRoleId], references: [id], onDelete: SetNull)
  roleAssignments        UserRole[]        @relation("UserRoleMember")
  rolesAssignedByMe      UserRole[]        @relation("UserRoleAssignedBy")
  deletedMaterials           Material[]          @relation("MaterialDeletedBy")
  deletedLabourCategories    LabourCategory[]    @relation("LabourCategoryDeletedBy")
  deletedLabourSubcategories LabourSubcategory[] @relation("LabourSubcategoryDeletedBy")
  createdContracts           ContractorContract[]        @relation("ContractCreatedBy")
  deletedContracts           ContractorContract[]        @relation("ContractDeletedBy")
  cancelledContracts         ContractorContract[]        @relation("ContractCancelledBy")
  reversedSettlements        ContractorSettlement[]      @relation("SettlementReversedBy")
  createdContractPayments    ContractorContractPayment[] @relation("ContractPaymentCreatedBy")
  deletedContractPayments    ContractorContractPayment[] @relation("ContractPaymentDeletedBy")
  createdScopeItems          ContractScopeItem[]         @relation("ScopeItemCreatedBy")
  deletedScopeItems          ContractScopeItem[]         @relation("ScopeItemDeletedBy")
  createdScopeRates          ContractScopeRateRevision[] @relation("ScopeRateCreatedBy")
  createdMilestones          ContractMilestone[]         @relation("MilestoneCreatedBy")
  completedMilestones        ContractMilestone[]         @relation("MilestoneCompletedBy")
  deletedMilestones          ContractMilestone[]         @relation("MilestoneDeletedBy")
  requestedAmendments        ContractAmendment[]         @relation("AmendmentRequestedBy")
  approvedAmendments         ContractAmendment[]         @relation("AmendmentApprovedBy")
  deletedAmendments          ContractAmendment[]         @relation("AmendmentDeletedBy")
  pclrRateRevisions          ProjectContractorLabourRateRevision[] @relation("PclrRevisionChangedBy")

  @@index([companyId])
  @@index([companyRoleId])
  @@map("users")
}

/// RBAC role — a named, per-company collection of permission keys (see
/// features/rbac/permissions.ts). Roles are DATA, not code: each company owns
/// its own set, seeded from SYSTEM_ROLES and extensible with custom roles.
/// `isOwner` marks the protected all-access role (implicit every permission).
model CompanyRole {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// Stable identifier for a seeded system role ("owner", "admin", …); null for
  /// custom roles. Unique per company (partial index — see migration).
  key         String?
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isOwner     Boolean  @default(false) @map("is_owner")
  /// Permission keys granted by this role. Supports concrete keys and wildcards
  /// ("*", "projects.*"), expanded at resolve time. Ignored for the owner role,
  /// whose access is implicit. The code catalog is authoritative for valid keys.
  permissions String[] @default([])
  /// Optional parent role to inherit permissions from (role hierarchy). Null =
  /// no parent. Schema-ready for Phase 4; resolution flattening lands with it.
  parentId    String?  @map("parent_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      CompanyRole?  @relation("RoleInheritance", fields: [parentId], references: [id], onDelete: SetNull)
  children    CompanyRole[] @relation("RoleInheritance")
  users       User[]        @relation("UserCompanyRole")
  assignments UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentId])
  @@map("roles")
}

/// User↔role junction — the authoritative record of which roles a user holds.
/// Today every user has exactly one row (mirroring the primary role), but the
/// many-to-many shape means multiple roles per user need NO future migration:
/// the session simply unions permissions across all rows. `isPrimary` marks the
/// user's default/primary role (also denormalised on User.companyRoleId).
model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  isPrimary    Boolean  @default(false) @map("is_primary")
  /// Who assigned this role (audit provenance); null for system/seed assignment.
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User        @relation("UserRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  role       CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User?       @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([companyId])
  @@index([roleId])
  @@map("user_roles")
}

/// A pending/accepted email invitation to join a company with a given role.
/// Backed by a Supabase auth invite; the app user row is created on accept.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  email       String
  role        Role             @default(PROJECT_MANAGER)
  status      InvitationStatus @default(PENDING)
  /// The Supabase auth user created by the invite (for cleanup on cancel).
  authUserId  String?          @map("auth_user_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  acceptedAt  DateTime?        @map("accepted_at")
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([companyId, status])
  @@index([email])
  @@map("invitations")
}

/// A construction project — the spine other modules reference.
model Project {
  id                     String       @id @default(uuid()) @db.Uuid
  companyId              String       @map("company_id") @db.Uuid
  code                   String
  name                   String
  type                   ProjectType
  stage                  ProjectStage @default(CREATED)
  clientName             String?      @map("client_name")
  clientContact          String?      @map("client_contact")
  clientPhone            String?      @map("client_phone")
  clientEmail            String?      @map("client_email")
  siteAddress            String?      @map("site_address")
  gpsLat                 Float?       @map("gps_lat")
  gpsLng                 Float?       @map("gps_lng")
  /// Integer paise (BigInt — budgets can exceed Int32). DTOs expose as number.
  budgetPaise            BigInt       @default(0) @map("budget_paise")
  contractValuePaise     BigInt       @default(0) @map("contract_value_paise")
  /// Dedicated procurement budget (independent of budgetPaise). Null = not set.
  procurementBudgetPaise BigInt?      @map("procurement_budget_paise")
  startDate              DateTime?    @map("start_date") @db.Date
  expectedCompletionDate DateTime?    @map("expected_completion_date") @db.Date
  tags                   String[]     @default([])
  pmId                   String?      @map("pm_id") @db.Uuid
  createdById            String       @map("created_by_id") @db.Uuid
  archivedAt             DateTime?    @map("archived_at")
  deletedAt              DateTime?    @map("deleted_at")
  /// Who soft-deleted the project and why (audit/recovery). Null unless deleted.
  deletedById            String?      @map("deleted_by_id") @db.Uuid
  deletedReason          String?      @map("deleted_reason")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  company               Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pm                    User?                         @relation("ProjectManager", fields: [pmId], references: [id], onDelete: SetNull)
  createdBy             User                          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  deletedBy             User?                         @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deadlines             Deadline[]
  documents             ProjectDocument[]
  notes                 Note[]
  favorites             ProjectFavorite[]
  labourAttendance      LabourAttendance[]
  purchaseOrders        PurchaseOrder[]
  vendorPayments        VendorPayment[]
  goodsReceipts         GoodsReceipt[]
  contractorSettlements ContractorSettlement[]
  contractorAssignments ProjectContractorAssignment[]
  projectContractors    ProjectContractor[]
  contracts             ContractorContract[]
  contractPayments      ContractorContractPayment[]
  contractScopeItems    ContractScopeItem[]
  contractScopeRates    ContractScopeRateRevision[]
  contractMilestones    ContractMilestone[]
  contractAmendments    ContractAmendment[]
  pclrRevisions         ProjectContractorLabourRateRevision[]
  contractorLedger      ContractorLedgerEntry[]
  settlementBreakdowns  ContractorSettlementBreakdown[]

  @@unique([companyId, code])
  @@index([companyId, stage])
  @@index([companyId, pmId])
  @@index([companyId, archivedAt])
  @@map("projects")
}

model Deadline {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  dueDate     DateTime  @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("deadlines")
}

model ProjectDocument {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  category     DocumentCategory @default(OTHER)
  storagePath  String           @map("storage_path")
  filename     String
  sizeBytes    Int              @map("size_bytes")
  mimeType     String           @map("mime_type")
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("project_documents")
}

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  body       String
  authorId   String   @map("author_id") @db.Uuid
  /// Client-generated id for offline idempotency (see lib/sync).
  clientUuid String   @unique @map("client_uuid")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("notes")
}

/// Per-user project pin/favorite.
model ProjectFavorite {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_favorites")
}

/// Immutable audit trail. Feeds the dashboard "Recent activity".
model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    String
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("activity_logs")
}

enum ContractorStatus {
  ACTIVE
  INACTIVE
}

/// Labor contractor. Kept intentionally lean; future modules add payments,
/// invoices, advances, and a ledger as NEW tables referencing contractorId —
/// no redesign of this model required.
model Contractor {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @map("company_id") @db.Uuid
  name                String
  phone               String?
  status              ContractorStatus @default(ACTIVE)
  /// Opening advance carried in at contractor creation (integer paise). Seeds
  /// the first ledger entry; the ledger is the authoritative running balance.
  openingAdvancePaise BigInt           @default(0) @map("opening_advance_paise")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger             ContractorLedgerEntry[]
  settlements        ContractorSettlement[]
  attendance         LabourAttendance[]
  assignments        ProjectContractorAssignment[]
  projectContractors ProjectContractor[]
  contracts          ContractorContract[]
  contractPayments   ContractorContractPayment[]

  @@index([companyId, status])
  @@map("contractors")
}

/// Kinds of contractor ledger movements. Sign convention for the advance
/// balance: OPENING_ADVANCE / ADVANCE / SETTLEMENT_REVERSAL increase it;
/// ADJUSTMENT decreases it; LABOUR_BILL and PAYMENT are informational (no
/// advance-balance effect).
enum ContractorLedgerType {
  OPENING_ADVANCE
  ADVANCE
  LABOUR_BILL
  ADJUSTMENT
  PAYMENT
  /// Written only by reverseSettlement, in two shapes: restoring a drawdown to
  /// the advance it came from, and turning already-paid net cash back into an
  /// unapplied advance. Both INCREASE the balance.
  SETTLEMENT_REVERSAL
  /// A governed RE-SCOPE moves UNUSED advance money between scopes. Always
  /// written as a pair in one transaction, so the contractor's total advance
  /// balance is unchanged and NO cash moves: OUT decreases, IN increases.
  /// OUT.drawsFromEntryId = the advance being drained; IN.drawsFromEntryId =
  /// the OUT, which is the whole lineage. Never carries a settlementId — a
  /// transfer pays no labour.
  SCOPE_TRANSFER_OUT
  SCOPE_TRANSFER_IN
}

/// Append-only, immutable contractor ledger.
///
/// Scope: an entry may be company-wide (both projectId and contractId NULL —
/// the legacy shape, unchanged), project-scoped, or agreement-scoped. Money the
/// contractor was given for specific work keeps that attribution, and a
/// settlement consumes advances strictly-to-broad (see allocateAdvanceDrawdown).
///
/// A LABOUR ADVANCE here is NOT agreement credit. It pre-pays future labour and
/// is netted off a settlement; the agreement is credited by the attendance that
/// settlement recognises. Direct commercial payment against an agreement is a
/// ContractorContractPayment instead.
model ContractorLedgerEntry {
  id                       String               @id @default(uuid()) @db.Uuid
  companyId                String               @map("company_id") @db.Uuid
  contractorId             String               @map("contractor_id") @db.Uuid
  date                     DateTime             @db.Date
  type                     ContractorLedgerType
  /// Unsigned magnitude in paise; the sign is implied by `type`. BigInt: a
  /// single settlement payment can exceed the Int32 ceiling of ₹2,14,74,836.
  amountPaise              BigInt               @map("amount_paise")
  /// HISTORICAL FOOTPRINT — the balance immediately after this entry, as written.
  /// NEVER the source of truth for the CURRENT balance: reversals append later
  /// entries, so this value is deliberately not updated. Current balance is
  /// always the fold over the entries (advanceBalancePaise).
  advanceBalanceAfterPaise BigInt               @map("advance_balance_after_paise")
  notes                    String?
  settlementId             String?              @map("settlement_id") @db.Uuid
  /// Scope. Enforced in SQL by CHECK (contract_id IS NULL OR project_id IS NOT
  /// NULL), and by composite FKs proving the agreement belongs to this same
  /// company + contractor + project.
  projectId                String?              @map("project_id") @db.Uuid
  contractId               String?              @map("contract_id") @db.Uuid
  /// EXPLICIT provenance — one meaning per field, never polymorphic.
  /// ADJUSTMENT → the advance entry it consumes. SCOPE_TRANSFER_OUT → the
  /// advance it drains; SCOPE_TRANSFER_IN → the OUT that created it.
  drawsFromEntryId         String?              @map("draws_from_entry_id") @db.Uuid
  /// SETTLEMENT_REVERSAL → the ADJUSTMENT it restores. NULL on the
  /// unapplied-cash entry, which is traced through settlementId instead.
  reversesEntryId          String?              @map("reverses_entry_id") @db.Uuid
  /// ADJUSTMENT → the composition BUCKET this drawdown funded (NULL = the
  /// unattributed bucket). Distinct from contractId, which is the scope of the
  /// advance CONSUMED: a project or legacy advance may fund an agreement's
  /// share, so the two differ and both must be recorded.
  fundsContractId          String?              @map("funds_contract_id") @db.Uuid
  createdById              String               @map("created_by_id") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor Contractor            @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: financial ledger history must never disappear
  /// because a settlement row is deleted. Correction is reversal, not deletion.
  settlement ContractorSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  project    Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Self-references so a provenance chain can never point at a missing row.
  drawsFrom  ContractorLedgerEntry?  @relation("LedgerDrawsFrom", fields: [drawsFromEntryId], references: [id], onDelete: Restrict)
  drawnBy    ContractorLedgerEntry[] @relation("LedgerDrawsFrom")
  reverses   ContractorLedgerEntry?  @relation("LedgerReverses", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy ContractorLedgerEntry[] @relation("LedgerReverses")
  /// Scope of the advance itself.
  contract   ContractorContract?     @relation("LedgerScopedTo", fields: [contractId], references: [id], onDelete: Restrict)
  /// Bucket a drawdown funded — may differ from `contract` (see fundsContractId).
  fundsContract ContractorContract?  @relation("LedgerFundsBucket", fields: [fundsContractId], references: [id], onDelete: Restrict)

  @@index([companyId, contractorId, createdAt])
  @@index([companyId, settlementId])
  @@index([companyId, contractorId, contractId])
  @@map("contractor_ledger_entries")
}

/// A weekly contractor settlement for one project + period. Snapshots the
/// computed labour bill, the advance adjustment applied, the resulting net
/// cash payment, and the advance balance afterwards. Immutable once created;
/// it emits LABOUR_BILL, (optional) ADJUSTMENT, and PAYMENT ledger entries.
model ContractorSettlement {
  id                       String   @id @default(uuid()) @db.Uuid
  companyId                String   @map("company_id") @db.Uuid
  contractorId             String   @map("contractor_id") @db.Uuid
  projectId                String   @map("project_id") @db.Uuid
  periodStart              DateTime @map("period_start") @db.Date
  periodEnd                DateTime @map("period_end") @db.Date
  /// Σ estimated labour cost for this contractor on this project in the period.
  labourBillPaise          BigInt   @map("labour_bill_paise")
  /// Advance drawn down against the bill (≤ min(outstanding advance, bill)).
  advanceAdjustmentPaise   BigInt   @default(0) @map("advance_adjustment_paise")
  /// Net cash paid = labourBill − advanceAdjustment.
  netPaymentPaise          BigInt   @map("net_payment_paise")
  /// HISTORICAL FOOTPRINT, as written. Not the current balance — see the note
  /// on ContractorLedgerEntry.advanceBalanceAfterPaise.
  advanceBalanceAfterPaise BigInt   @map("advance_balance_after_paise")
  notes                    String?
  /// Reversal. The settlement is never deleted: it keeps its figures, its
  /// ledger entries and its breakdown, and simply stops being live.
  reversedAt               DateTime? @map("reversed_at")
  reversedById             String?   @map("reversed_by_id") @db.Uuid
  reversalReason           String?   @map("reversal_reason")
  createdById              String   @map("created_by_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor Contractor              @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reversedBy User?                   @relation("SettlementReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  ledger     ContractorLedgerEntry[]
  /// Attendance rows this settlement financially RECOGNISED. Stamped once, at
  /// creation; a stamped row is immutable to ordinary attendance editing.
  attendance LabourAttendance[]
  /// Immutable record of the composition this settlement acted on.
  breakdown  ContractorSettlementBreakdown[]

  @@index([companyId, contractorId, createdAt])
  @@index([companyId, projectId])
  @@map("contractor_settlements")
}

/// What a settlement knew about its own composition, AT THE TIME IT RAN.
///
/// One row per composition bucket: an agreement, or NULL for labour that wasn't
/// attributed to any agreement. Written inside createSettlement's transaction
/// and never rewritten afterwards.
///
/// This exists because reversal must not reconstruct composition from today's
/// LabourAttendance.contractId. Historical attribution can legitimately change
/// those values later, so a settlement attributed AFTER it ran would otherwise
/// reverse against a composition it never actually used, and cash would be
/// attributed to the wrong agreement.
///
/// Invariants, enforced on write:
///   Σ labourBillPaise        = settlement.labourBillPaise
///   Σ advanceAdjustmentPaise = settlement.advanceAdjustmentPaise
///   Σ netPaymentPaise        = settlement.netPaymentPaise
///   per row: labourBill      = advanceAdjustment + netPayment
model ContractorSettlementBreakdown {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  /// Denormalized from the settlement so RLS uses the flat project-scoped shape.
  projectId              String   @map("project_id") @db.Uuid
  settlementId           String   @map("settlement_id") @db.Uuid
  /// The composition bucket. NULL = the unattributed bucket.
  contractId             String?  @map("contract_id") @db.Uuid
  labourBillPaise        BigInt   @map("labour_bill_paise")
  advanceAdjustmentPaise BigInt   @map("advance_adjustment_paise")
  netPaymentPaise        BigInt   @map("net_payment_paise")
  createdAt              DateTime @default(now()) @map("created_at")

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  settlement ContractorSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  contract   ContractorContract?  @relation(fields: [contractId], references: [id], onDelete: Restrict)

  // UNIQUE (settlement_id, contract_id) NULLS NOT DISTINCT lives in SQL — Prisma
  // cannot express NULLS NOT DISTINCT, and the null bucket must be unique too.
  @@index([companyId, settlementId])
  @@map("contractor_settlement_breakdowns")
}

/// A labour category (trade group), e.g. Carpenter, Electrician, Mason.
/// Categories contain subcategories; attendance is recorded per subcategory.
model LabourCategory {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  color        String?
  displayOrder Int      @default(0) @map("display_order")
  /// Owner Force Delete soft-deletes (deactivates) a group: `deletedAt` set, the
  /// row hidden from all master data / config / pickers, but KEPT so historical
  /// attendance still resolves its name (never a physical delete — see
  /// features/labor/server/actions.ts forceDeleteCategory). deletedById records
  /// the acting Owner.
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company       Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedBy     User?                         @relation("LabourCategoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  subcategories LabourSubcategory[]
  assignments   ProjectContractorAssignment[]

  // Name uniqueness is enforced by a PARTIAL unique index (WHERE deleted_at IS
  // NULL) so a name freed by a soft-delete can be reused — see
  // prisma/migration-labour-force-delete.sql. Prisma can't express partial
  // unique, so the compile-time @@unique is intentionally omitted here.
  @@index([companyId, displayOrder])
  @@index([companyId, deletedAt])
  @@map("labour_categories")
}

/// A labour subcategory, e.g. "Main Carpenter" / "Carpenter Helper" under
/// Carpenter. dailyRatePaise is an OPTIONAL day rate used only for estimated
/// labour cost (rate × headcount) — not per-worker tracking.
model LabourSubcategory {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  name           String
  dailyRatePaise Int?     @map("daily_rate_paise")
  displayOrder   Int      @default(0) @map("display_order")
  /// Owner Force Delete soft-deletes (deactivates) a labour type: `deletedAt`
  /// set, the row hidden from master data / config / pickers but KEPT so
  /// historical attendance still resolves its name. See forceDeleteSubcategory.
  deletedAt      DateTime? @map("deleted_at")
  deletedById    String?   @map("deleted_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company                Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category               LabourCategory                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  deletedBy              User?                         @relation("LabourSubcategoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  attendance             LabourAttendance[]
  projectContractorRates ProjectContractorLabourRate[]
  contractScopeItems     ContractScopeItem[]

  // Name uniqueness within a group is a PARTIAL unique index (WHERE deleted_at
  // IS NULL) — see prisma/migration-labour-force-delete.sql. Compile-time
  // @@unique intentionally omitted (Prisma can't express partial unique).
  @@index([companyId, categoryId, displayOrder])
  @@index([companyId, deletedAt])
  @@map("labour_subcategories")
}

/// Which contractor handles which work category on a given project (the
/// client's "Pappu → Civil, Shoeb → Tiles"). A project may have many rows; a
/// contractor may serve many projects with different categories. This is an
/// ELIGIBILITY/CONFIG layer only — it never touches the immutable contractor
/// ledger. Reuses the existing LabourCategory taxonomy (no parallel system).
/// Labour attendance restricts its contractor options to these rows and
/// attributes each category group to the contractor assigned to it here.
model ProjectContractorAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  contractorId     String   @map("contractor_id") @db.Uuid
  labourCategoryId String   @map("labour_category_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  category   LabourCategory @relation(fields: [labourCategoryId], references: [id], onDelete: Cascade)

  @@unique([projectId, contractorId, labourCategoryId])
  @@index([companyId, projectId])
  @@index([companyId, contractorId])
  @@map("project_contractor_assignments")
}

/// A contractor engaged on a project (the client's "Anjali → Pappu, Saddam").
/// The CONTRACTOR is the top-level grouping the Labour module presents; the
/// labour types they supply on this project (with per-type rates) hang off this
/// row via ProjectContractorLabourRate. `contractRatePaise`/`contractRateUnit`
/// hold an OPTIONAL project-level agreement figure (e.g. ₹240/sq.ft) — a
/// DIFFERENT concept from labour day-rates: display/store only, never fed into
/// daily attendance or settlement. Supersedes ProjectContractorAssignment.
model ProjectContractor {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  contractorId      String   @map("contractor_id") @db.Uuid
  /// Optional project agreement rate (integer paise). Not used for attendance.
  contractRatePaise Int?     @map("contract_rate_paise")
  /// Unit for the agreement rate: "sqft" | "lumpsum" | … (free text). Null when
  /// no agreement rate is set.
  contractRateUnit  String?  @map("contract_rate_unit")
  // Intentionally NO paymentModel: a contractor↔project relationship cannot have
  // one billing method. It may carry attendance-only labour, one or several
  // commercial agreements, or both at once — the method belongs to each
  // ContractorContract, never to the relationship.
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company     Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor  Contractor                    @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  labourRates ProjectContractorLabourRate[]

  @@unique([projectId, contractorId])
  @@index([companyId, projectId])
  @@index([companyId, contractorId])
  @@map("project_contractors")
}

/// Which labour types a contractor supplies on a project, and the PROJECT-
/// SPECIFIC day rate for each. Reuses the LabourSubcategory taxonomy (Mason,
/// Helper, Centering, …) — the same subcategory can appear under multiple
/// contractors on one project (Pappu-Centering ₹850 and Saddam-Centering ₹950
/// coexist). Attendance snapshots ratePaise at record time; editing it later
/// never rewrites history (attendance keeps its own snapshot).
model ProjectContractorLabourRate {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  projectContractorId String   @map("project_contractor_id") @db.Uuid
  labourSubcategoryId String   @map("labour_subcategory_id") @db.Uuid
  /// Project-specific day rate (integer paise).
  ratePaise           Int      @map("rate_paise")
  rateUnit            String   @default("day") @map("rate_unit")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectContractor ProjectContractor  @relation(fields: [projectContractorId], references: [id], onDelete: Cascade)
  subcategory       LabourSubcategory  @relation(fields: [labourSubcategoryId], references: [id], onDelete: Cascade)
  attendance        LabourAttendance[]
  revisions         ProjectContractorLabourRateRevision[]

  @@unique([projectContractorId, labourSubcategoryId])
  @@index([companyId, projectContractorId])
  @@index([companyId, labourSubcategoryId])
  @@map("project_contractor_labour_rates")
}

/// Contractor-first daily attendance: the number of workers present for a
/// labour subcategory on a project + date, ATTRIBUTED TO A CONTRACTOR.
/// Offline-syncable (clientUuid idempotency, clientSeq order). Identity is
/// (project, date, subcategory, contractor) — enforced in SQL as a
/// UNIQUE … NULLS NOT DISTINCT index so two contractors can supply the same
/// subcategory on the same project/date (Pappu-Centering + Saddam-Centering)
/// while legacy null-contractor rows keep one-row-per-triple semantics.
/// The effective day rate (project + contractor + subcategory, falling back to
/// the subcategory's global rate) is SNAPSHOTTED at record time — editing a
/// rate later never rewrites historical cost (ADR-0022).
model LabourAttendance {
  id                            String   @id @default(uuid()) @db.Uuid
  companyId                     String   @map("company_id") @db.Uuid
  projectId                     String   @map("project_id") @db.Uuid
  date                          DateTime @db.Date
  labourSubcategoryId           String   @map("labour_subcategory_id") @db.Uuid
  /// Optional contractor this labour is attributed to. Nullable: legacy rows
  /// and unattributed labour have none; a contractor's weekly bill sums the
  /// estimatedCostPaise of their attributed rows in the period.
  contractorId                  String?  @map("contractor_id") @db.Uuid
  /// Provenance of the snapshotted rate: the ProjectContractorLabourRate the
  /// rate came from. Null when the rate fell back to the subcategory's global
  /// rate, or for legacy rows. SetNull on delete so history survives config edits.
  projectContractorLabourRateId String?  @map("project_contractor_labour_rate_id") @db.Uuid
  /// The commercial agreement this labour is attributed to. NULL = attendance-only
  /// (the pre-existing path, unchanged). Part of the row IDENTITY so one
  /// contractor holding two agreements on a project can record the same labour
  /// type on the same date under each. SetNull so history survives.
  contractId                    String?  @map("contract_id") @db.Uuid
  /// TIER-1 rate provenance: the effective-dated agreement rate revision the
  /// snapshot came from (mirrors projectContractorLabourRateId for tier 2).
  contractScopeRateRevisionId   String?  @map("contract_scope_rate_revision_id") @db.Uuid
  /// The settlement that financially RECOGNISED this row's labour value.
  /// Stamped once, inside createSettlement's transaction, on rows not already
  /// stamped. Two jobs: (1) agreement Attendance Credit counts only settled rows
  /// — settlement is the canonical record of attendance money; (2) a stamped row
  /// is financially IMMUTABLE, so recognised value can never drift away from the
  /// settlement that recognised it. Changing settled labour requires a governed
  /// settlement reversal, never a plain attendance edit.
  settlementId                  String?  @map("settlement_id") @db.Uuid
  /// Headcount present. Float to allow half-day (0.5) increments; 0.5 steps
  /// are exactly representable, and legacy whole-number rows are unaffected.
  quantityPresent               Float    @map("quantity_present")
  /// Rate snapshot at first recording (null if no rate resolved).
  dailyRatePaiseSnapshot        Int?     @map("daily_rate_paise_snapshot")
  /// quantityPresent × dailyRatePaiseSnapshot, stored for immutable history.
  estimatedCostPaise            Int      @default(0) @map("estimated_cost_paise")
  notes                         String?
  clientUuid                    String   @unique @map("client_uuid")
  clientSeq                     BigInt   @map("client_seq")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  company     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcategory LabourSubcategory            @relation(fields: [labourSubcategoryId], references: [id], onDelete: Cascade)
  contractor  Contractor?                  @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  rate        ProjectContractorLabourRate? @relation(fields: [projectContractorLabourRateId], references: [id], onDelete: SetNull)
  contract    ContractorContract?          @relation(fields: [contractId], references: [id], onDelete: SetNull)
  scopeRate   ContractScopeRateRevision?   @relation(fields: [contractScopeRateRevisionId], references: [id], onDelete: SetNull)
  settlement  ContractorSettlement?        @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  // Identity = (project, date, subcategory, contractor, contract). The DB
  // enforces this as UNIQUE … NULLS NOT DISTINCT (see prisma/migration-
  // contractor-contracts.sql, which supersedes the 4-column index from
  // migration-attendance-contractor-identity.sql) so NULL-contractor and
  // NULL-contract rows still keep one-row-per-(project,date,subcategory).
  // Prisma has no schema syntax for NULLS NOT DISTINCT, and the compound-unique
  // accessor it generates (projectId_date_labourSubcategoryId_contractorId_
  // contractId) types BOTH nullable columns as NON-null — so it CANNOT target a
  // NULL-contractor or NULL-contract row. The write paths therefore never use
  // that accessor: setQuantity / applyLabourAttendance / copyPreviousDay do
  // findFirst (nullable-safe) → update-by-id or create, and clears use
  // deleteMany. Every such WHERE must carry contractId, or clearing one
  // agreement's row silently deletes another agreement's row for the same
  // date+subcategory. The DB unique index is the concurrency backstop; a rare
  // race surfaces as a create error that the interactive path reports and the
  // offline outbox retries into an update.
  @@unique([projectId, date, labourSubcategoryId, contractorId, contractId])
  @@index([companyId, contractorId, date])
  @@index([companyId, projectId, date])
  @@index([companyId, date])
  @@index([companyId, contractId, date])
  @@index([companyId, settlementId])
  @@map("labour_attendance")
}

/// Lifecycle of a contractor's commercial agreement (work package).
/// SETTLED is not a free label: setContractStatus permits COMPLETED → SETTLED
/// only when currentDue is 0 AND every non-cancelled milestone is COMPLETED. It
/// is an administrative close-out sign-off, distinct from the DERIVED financial
/// state (due / settled / ahead) that reconciliation computes continuously.
enum ContractStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  SETTLED
  CANCELLED
}

/// PHYSICAL progress of an earned-value checkpoint — deliberately not a
/// financial state. Payments are cumulative at agreement level and never live in
/// per-milestone wallets, so "settled" is derived from cumulative reconciliation
/// at the checkpoint, never stamped here by a user.
enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Why an agreement's commercial terms were revised.
enum AmendmentType {
  VARIATION
  SCOPE_CHANGE
  RATE_CHANGE
  TIME_EXTENSION
  OTHER
}

/// Amendment approval state. Only APPROVED rows move the contract value —
/// maker/checker: proposing needs contracts.edit, approving contracts.amend_approve.
enum AmendmentStatus {
  PROPOSED
  APPROVED
  REJECTED
}

/// Classification of a fixed-contract payment. Informational (drives labelling
/// and the lifetime advance/other split) — none of these change the contract
/// value; only the contract amount itself does.
enum ContractPaymentType {
  ADVANCE
  INTERIM
  MILESTONE
  WEEKLY
  DAILY
  FINAL
  OTHER
}

/// A contractor's COMMERCIAL AGREEMENT (work package) on a project — "Pappu
/// Contractor → Project A → Structure, ₹60,00,000, 6 slabs". One contractor may
/// hold several agreements on one project; each is financially isolated (own
/// scope, rates, rate history, milestones, payments, reconciliation), and one
/// agreement's advance must never offset another's liability.
///
/// Coexists with attendance-only engagement: a contractor can supply labour on a
/// project with no agreement at all (ProjectContractorLabourRate), which is why
/// there is no per-relationship "payment model" — the relationship cannot have
/// one, only the individual agreements can.
///
/// Value: `originalAmountPaise` is IMMUTABLE after creation; every change flows
/// through an approved ContractAmendment. `currentAmountPaise` is the authorised
/// value (original + Σ approved deltas), denormalized because every list and
/// summary read needs it — written ONLY inside approveAmendment's transaction,
/// and re-derived on the read path as a drift guard.
model ContractorContract {
  id                     String         @id @default(uuid()) @db.Uuid
  companyId              String         @map("company_id") @db.Uuid
  contractorId           String         @map("contractor_id") @db.Uuid
  projectId              String         @map("project_id") @db.Uuid
  title                  String
  /// Human agreement/reference number, if the company uses one.
  reference              String?
  scope                  String?
  /// Informational quantity (e.g. 20 bathrooms, 17.5 running metres). NUMERIC,
  /// never Float — binary floating point has no place in ERP quantities.
  quantity               Decimal?       @db.Decimal(12, 3)
  /// Informational unit label (e.g. "Bathrooms", "sq.ft"). Null when unset.
  unit                   String?
  /// Value agreed at signing (integer paise). IMMUTABLE — never edited in place.
  originalAmountPaise    BigInt         @map("original_amount_paise")
  /// Currently AUTHORISED value = original + Σ APPROVED amendment deltas. Both
  /// the earned-value ceiling and the credit ceiling are measured against this.
  currentAmountPaise     BigInt         @map("current_amount_paise")
  startDate              DateTime?      @map("start_date") @db.Date
  expectedCompletionDate DateTime?      @map("expected_completion_date") @db.Date
  status                 ContractStatus @default(NOT_STARTED)
  notes                  String?
  completedAt            DateTime?      @map("completed_at")
  settledAt              DateTime?      @map("settled_at")
  cancelledAt            DateTime?      @map("cancelled_at")
  cancelledById          String?        @map("cancelled_by_id") @db.Uuid
  cancelledReason        String?        @map("cancelled_reason")
  createdById            String         @map("created_by_id") @db.Uuid
  /// Soft-delete, reserved for an agreement created by mistake and never used.
  /// Once it has financial history the business path is CANCELLED, and
  /// deleteContract refuses (HAS_FINANCIAL_HISTORY).
  deletedAt              DateTime?      @map("deleted_at")
  deletedById            String?        @map("deleted_by_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor  Contractor                  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                        @relation("ContractCreatedBy", fields: [createdById], references: [id])
  deletedBy   User?                       @relation("ContractDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  cancelledBy User?                       @relation("ContractCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  payments    ContractorContractPayment[]
  scopeItems  ContractScopeItem[]
  rateRevisions ContractScopeRateRevision[]
  milestones  ContractMilestone[]
  amendments  ContractAmendment[]
  attendance  LabourAttendance[]
  scopedLedgerEntries ContractorLedgerEntry[] @relation("LedgerScopedTo")
  fundedLedgerEntries ContractorLedgerEntry[] @relation("LedgerFundsBucket")
  settlementBreakdowns ContractorSettlementBreakdown[]

  // Backs the composite FKs from contractor_ledger_entries proving an
  // agreement-scoped entry belongs to the same company + contractor + project.
  @@unique([id, companyId, contractorId, projectId])
  @@index([companyId, contractorId])
  @@index([companyId, projectId])
  @@index([companyId, status])
  @@index([companyId, contractorId, projectId])
  @@map("contractor_contracts")
}

/// A labour type (subcategory) covered by an agreement's commercial scope, and
/// the TIER-1 rate carrier. Coexists with ProjectContractorLabourRate (tier 2,
/// attendance-only): agreement scope is self-sufficient eligibility, so a
/// contractor needs no separate project-contractor rate to work under an
/// agreement.
///
/// `currentRatePaise` is a read accelerator only — the authoritative rate history
/// is ContractScopeRateRevision, and attendance resolves the revision effective
/// on the row's OWN date. Uniqueness of (contract, subcategory) among live rows
/// is a PARTIAL unique index in SQL (WHERE deleted_at IS NULL); Prisma cannot
/// express partial unique, so it is deliberately absent here (precedent:
/// LabourCategory / LabourSubcategory).
model ContractScopeItem {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  /// Denormalized from the contract so RLS uses the same flat project policy as
  /// every other project-scoped table.
  projectId           String    @map("project_id") @db.Uuid
  contractId          String    @map("contract_id") @db.Uuid
  labourSubcategoryId String    @map("labour_subcategory_id") @db.Uuid
  /// Rate of the revision effective TODAY (integer paise). Int, not BigInt:
  /// this is a DAY RATE (Int32 ceiling ₹21,47,483/day), matching
  /// LabourSubcategory.dailyRatePaise and ProjectContractorLabourRate.ratePaise
  /// so rate resolution stays free of BigInt conversion.
  currentRatePaise    Int       @map("current_rate_paise")
  rateUnit            String    @default("day") @map("rate_unit")
  notes               String?
  deletedAt           DateTime? @map("deleted_at")
  deletedById         String?   @map("deleted_by_id") @db.Uuid
  createdById         String    @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract    ContractorContract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  subcategory LabourSubcategory           @relation(fields: [labourSubcategoryId], references: [id], onDelete: Cascade)
  createdBy   User                        @relation("ScopeItemCreatedBy", fields: [createdById], references: [id])
  deletedBy   User?                       @relation("ScopeItemDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  revisions   ContractScopeRateRevision[]

  @@index([companyId, contractId])
  @@index([companyId, labourSubcategoryId])
  @@map("contract_scope_items")
}

/// APPEND-ONLY effective-dated rate history for an agreement scope item. An
/// agreed rate is never overwritten: a revision is a new row, and a correction
/// is another new row. Deliberately has NO soft-delete — erasable rate history
/// is exactly what this model exists to prevent.
///
/// Resolution is derived, not stored: the rate in force on a date is the latest
/// effectiveFrom <= date, tiebroken by createdAt desc. There is no effectiveTo
/// column, so there is no closing-date invariant that can drift.
model ContractScopeRateRevision {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  contractId    String   @map("contract_id") @db.Uuid
  scopeItemId   String   @map("scope_item_id") @db.Uuid
  /// Day rate in paise. Int for the same reason as ContractScopeItem.
  ratePaise     Int      @map("rate_paise")
  rateUnit      String   @default("day") @map("rate_unit")
  effectiveFrom DateTime @map("effective_from") @db.Date
  reason        String?
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract   ContractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  scopeItem  ContractScopeItem  @relation(fields: [scopeItemId], references: [id], onDelete: Cascade)
  createdBy  User               @relation("ScopeRateCreatedBy", fields: [createdById], references: [id])
  attendance LabourAttendance[]

  @@index([companyId, scopeItemId, effectiveFrom])
  @@index([companyId, contractId])
  @@map("contract_scope_rate_revisions")
}

/// An earned-value checkpoint inside an agreement. Generic by design — "Slab 1",
/// "10 bathrooms complete", "Conduit work" are all just titles; nothing here is
/// slab-specific. Values need NOT be equal across milestones.
///
/// Earned value = Σ valuePaise WHERE status = COMPLETED. A milestone is NOT a
/// payment bucket: payments are cumulative at agreement level, and the optional
/// payment→milestone link is context for reporting only. Completing a milestone
/// is blocked when cumulative earned would exceed the authorised contract value
/// (EARNED_VALUE_EXCEEDS_CONTRACT) — raise an amendment first.
model ContractMilestone {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  contractId      String          @map("contract_id") @db.Uuid
  sequence        Int             @default(0)
  title           String
  description     String?
  /// Value recognised as earned when this milestone completes (integer paise).
  valuePaise      BigInt          @map("value_paise")
  plannedDate     DateTime?       @map("planned_date") @db.Date
  status          MilestoneStatus @default(NOT_STARTED)
  completedAt     DateTime?       @map("completed_at")
  completedById   String?         @map("completed_by_id") @db.Uuid
  cancelledAt     DateTime?       @map("cancelled_at")
  cancelledReason String?         @map("cancelled_reason")
  notes           String?
  createdById     String          @map("created_by_id") @db.Uuid
  deletedAt       DateTime?       @map("deleted_at")
  deletedById     String?         @map("deleted_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract    ContractorContract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy   User                        @relation("MilestoneCreatedBy", fields: [createdById], references: [id])
  completedBy User?                       @relation("MilestoneCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  deletedBy   User?                       @relation("MilestoneDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  payments    ContractorContractPayment[]

  @@index([companyId, contractId, sequence])
  @@index([companyId, projectId])
  @@index([companyId, status])
  @@map("contract_milestones")
}

/// A variation / amendment to an agreement's commercial value. The ONLY way the
/// authorised value changes — updateContract refuses an amount outright
/// (USE_AMENDMENT), so no value change can happen without a reason, an effective
/// date, and an approver.
///
/// Maker/checker: proposing needs contracts.edit, approving needs
/// contracts.amend_approve. Only APPROVED rows move currentAmountPaise, and
/// approval re-checks that the snapshot it was proposed against is still current
/// (AMENDMENT_STALE) so two concurrent approvals can't both apply.
model ContractAmendment {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           String          @map("company_id") @db.Uuid
  projectId           String          @map("project_id") @db.Uuid
  contractId          String          @map("contract_id") @db.Uuid
  sequence            Int             @default(0)
  type                AmendmentType   @default(VARIATION)
  /// Authorised value BEFORE this amendment, snapshotted at proposal time.
  previousAmountPaise BigInt          @map("previous_amount_paise")
  revisedAmountPaise  BigInt          @map("revised_amount_paise")
  /// revised − previous. SIGNED (a variation may reduce scope). Stored so
  /// cumulative sums need no per-row subtraction.
  deltaPaise          BigInt          @map("delta_paise")
  /// Required — a value change with no stated reason is not auditable.
  reason              String
  effectiveDate       DateTime        @map("effective_date") @db.Date
  status              AmendmentStatus @default(PROPOSED)
  requestedById       String          @map("requested_by_id") @db.Uuid
  approvedById        String?         @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?       @map("approved_at")
  rejectedReason      String?         @map("rejected_reason")
  deletedAt           DateTime?       @map("deleted_at")
  deletedById         String?         @map("deleted_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract    ContractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  requestedBy User               @relation("AmendmentRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?              @relation("AmendmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  deletedBy   User?              @relation("AmendmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([companyId, contractId, effectiveDate])
  @@index([companyId, status])
  @@map("contract_amendments")
}

/// APPEND-ONLY audit trail for TIER-2 (attendance-only) rate changes. Records who
/// changed a ProjectContractorLabourRate, to what, and when — so "what was
/// Pappu's Centring rate in March?" is answerable for contractors who work
/// without an agreement too.
///
/// Deliberately NOT used for rate resolution: tier 2 still resolves the CURRENT
/// rate and snapshots it onto the attendance row (ADR-0022), which already makes
/// historical cost immutable. Only agreements get effective-dated resolution.
model ProjectContractorLabourRateRevision {
  id                            String   @id @default(uuid()) @db.Uuid
  companyId                     String   @map("company_id") @db.Uuid
  projectId                     String   @map("project_id") @db.Uuid
  projectContractorLabourRateId String   @map("project_contractor_labour_rate_id") @db.Uuid
  labourSubcategoryId           String   @map("labour_subcategory_id") @db.Uuid
  ratePaise                     Int      @map("rate_paise")
  rateUnit                      String   @default("day") @map("rate_unit")
  effectiveFrom                 DateTime @map("effective_from") @db.Date
  changedById                   String   @map("changed_by_id") @db.Uuid
  createdAt                     DateTime @default(now()) @map("created_at")

  company   Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rate      ProjectContractorLabourRate @relation(fields: [projectContractorLabourRateId], references: [id], onDelete: Cascade)
  changedBy User                        @relation("PclrRevisionChangedBy", fields: [changedById], references: [id])

  @@index([companyId, projectContractorLabourRateId, effectiveFrom])
  @@map("project_contractor_labour_rate_revisions")
}

/// A payment recorded against a fixed contract. Modeled on VendorPayment: reuses
/// PaymentMode, stores integer-paise BigInt, and carries an optional clientUuid
/// idempotency key (partial-unique in SQL). contractorId/projectId are
/// DENORMALIZED from the parent contract so project-isolated and cross-project
/// (lifetime) sums need no joins. Soft-delete (deletedAt) is the REVERSAL: a
/// reversed payment stops contributing to Total Paid / Balance / Lifetime while
/// the row + audit entry survive.
model ContractorContractPayment {
  id              String              @id @default(uuid()) @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  contractId      String              @map("contract_id") @db.Uuid
  contractorId    String              @map("contractor_id") @db.Uuid
  projectId       String              @map("project_id") @db.Uuid
  amountPaise     BigInt              @map("amount_paise")
  type            ContractPaymentType @default(OTHER)
  paymentMode     PaymentMode         @default(BANK_TRANSFER) @map("payment_mode")
  referenceNumber String?             @map("reference_number")
  date            DateTime            @db.Date
  notes           String?
  /// Optional milestone this payment was recorded against. CONTEXT ONLY — it
  /// never enters the cumulative math, because a milestone is an earned-value
  /// checkpoint, not a payment bucket. SetNull so deleting a milestone never
  /// destroys a payment.
  milestoneId     String?             @map("milestone_id") @db.Uuid
  /// Client-generated idempotency key. PARTIAL unique index
  /// (WHERE client_uuid IS NOT NULL) in the SQL migration dedups repeated
  /// submissions per contract.
  clientUuid      String?             @map("client_uuid")
  createdById     String              @map("created_by_id") @db.Uuid
  /// Soft-delete = reversal. Set to exclude from all financial totals while
  /// preserving the record and its audit trail.
  deletedAt       DateTime?           @map("deleted_at")
  deletedById     String?             @map("deleted_by_id") @db.Uuid
  reversalReason  String?             @map("reversal_reason")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract   ContractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractor Contractor         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone  ContractMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy  User               @relation("ContractPaymentCreatedBy", fields: [createdById], references: [id])
  deletedBy  User?              @relation("ContractPaymentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([companyId, contractId])
  @@index([companyId, projectId])
  @@index([companyId, contractorId])
  @@index([companyId, date])
  @@index([companyId, milestoneId])
  @@map("contractor_contract_payments")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

/// Company material master — the canonical catalogue of things this company
/// buys ("OPC 53 Cement", "TMT Steel 12mm"). Distinct from the material
/// CATEGORY presets in Company.settings.materialCategories, which group
/// materials; `category` below holds a value from that same string domain
/// (see features/procurement/constants.ts DEFAULT_MATERIAL_CATEGORIES).
///
/// DEACTIVATED, NEVER DELETED — exactly like LabourCategory. Setting
/// `deletedAt` hides the row from pickers while KEEPING it, so historical
/// PO lines that reference it still resolve. A PO line additionally snapshots
/// the name in POLineItem.material, so even a hard delete cannot rewrite
/// purchase history.
model Material {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String
  /// One of Company.settings.materialCategories (same domain as
  /// POLineItem.category). Deliberately a string, not an FK — the category
  /// taxonomy is Settings-managed and has no table.
  category     String?
  /// Pre-selected as the PO line unit; always overridable per line.
  defaultUnit  String?   @map("default_unit")
  hsnCode      String?   @map("hsn_code")
  displayOrder Int       @default(0) @map("display_order")
  /// Soft-delete (deactivation). Set = hidden from master data and pickers,
  /// row RETAINED so historical references keep resolving. deletedById records
  /// the acting user.
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedBy User?            @relation("MaterialDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  vendors   VendorMaterial[]
  poLines   POLineItem[]

  // Active-name uniqueness is CASE-INSENSITIVE and scoped per company. It is a
  // PARTIAL, EXPRESSION unique index —
  //     UNIQUE (company_id, lower(name)) WHERE deleted_at IS NULL
  // — created in prisma/migration-material-master.sql. Prisma can express
  // neither a partial nor an expression index, so the compile-time @@unique is
  // intentionally omitted here (same convention as LabourCategory). A name
  // freed by a deactivation becomes reusable; "Cement" and "cement" cannot both
  // be active in one company; two DIFFERENT companies may each have "Cement".
  //
  // @@unique([id, companyId]) exists only to back the COMPOSITE foreign keys on
  // vendor_materials, which is what makes a cross-company vendor-material link
  // structurally impossible rather than merely discouraged.
  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, category])
  @@map("materials")
}

/// Which materials a vendor NORMALLY supplies — eligibility/config only.
///
/// It records capability, nothing transactional: no quantities, no ordered
/// amounts, no received amounts, no dates, no history. What was ordered lives
/// on POLineItem; what arrived lives on GoodsReceiptItem. Unlinking a row here
/// changes only future pickers — it cannot touch an existing PO, its frozen
/// material snapshot, a goods receipt, or any report.
model VendorMaterial {
  companyId  String   @map("company_id") @db.Uuid
  vendorId   String   @map("vendor_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  // The composite primary key makes a duplicate vendor-material mapping
  // structurally impossible — no application check required.
  //
  // TENANT INTEGRITY: in the DATABASE the vendor and material references are
  // COMPOSITE foreign keys — (vendor_id, company_id) -> vendors(id, company_id)
  // and (material_id, company_id) -> materials(id, company_id) — so a row can
  // only ever join a vendor and a material belonging to the SAME company.
  // Prisma cannot model a composite FK whose columns overlap between two
  // relations, so the client-side relations above are declared single-column
  // and the real constraints live in prisma/migration-material-master.sql.
  // The DB is authoritative; this is the same kind of divergence the partial
  // unique indexes on labour_categories already carry.
  @@id([vendorId, materialId])
  @@index([companyId, materialId])
  @@map("vendor_materials")
}

/// A material supplier. Lean by design; future payments, ledger, credit
/// balances, and GST reports attach as NEW tables referencing vendorId —
/// no redesign of this model required.
model Vendor {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  businessName      String       @map("business_name")
  contactPerson     String?      @map("contact_person")
  phone             String?
  email             String?
  gstin             String?
  pan               String?
  address           String?
  materialsSupplied String[]     @default([]) @map("materials_supplied")
  paymentTerms      String?      @map("payment_terms")
  status            VendorStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materials      VendorMaterial[]
  purchaseOrders PurchaseOrder[]
  favorites      VendorFavorite[]
  payments       VendorPayment[]
  documents      VendorDocument[]
  goodsReceipts  GoodsReceipt[]

  // Backs the COMPOSITE foreign key (vendor_id, company_id) on
  // vendor_materials — the constraint that makes a cross-company
  // vendor-material link impossible. Additive and never rejecting: `id` is
  // already the primary key, so (id, company_id) is trivially unique.
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("vendors")
}

/// A document attached to a vendor (agreements, rate cards, GST certificates).
model VendorDocument {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  vendorId     String           @map("vendor_id") @db.Uuid
  category     DocumentCategory @default(OTHER)
  storagePath  String           @map("storage_path")
  filename     String
  sizeBytes    Int              @map("size_bytes")
  mimeType     String           @map("mime_type")
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([companyId, vendorId])
  @@map("vendor_documents")
}

/// Per-user vendor pin/favorite (optional).
model VendorFavorite {
  userId    String   @map("user_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([userId, vendorId])
  @@map("vendor_favorites")
}

/// A purchase order. Approved POs are immutable — changes go through a
/// "revise" that clones to a new draft linked via revisedFromId (audit trail).
model PurchaseOrder {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  vendorId         String              @map("vendor_id") @db.Uuid
  projectId        String              @map("project_id") @db.Uuid
  poNumber         String              @map("po_number")
  status           PurchaseOrderStatus @default(DRAFT)
  invoiceNumber    String?             @map("invoice_number")
  purchaseDate     DateTime            @map("purchase_date") @db.Date
  expectedDelivery DateTime?           @map("expected_delivery") @db.Date
  notes            String?
  /// Denormalized Σ line taxable amounts (integer paise, ex-GST).
  subtotalPaise    BigInt              @default(0) @map("subtotal_paise")
  /// Denormalized Σ line GST (integer paise).
  gstPaise         BigInt              @default(0) @map("gst_paise")
  /// Grand total = subtotal + GST (integer paise). Budget math uses this.
  totalPaise       BigInt              @default(0) @map("total_paise")
  createdById      String              @map("created_by_id") @db.Uuid
  approvedById     String?             @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?           @map("approved_at")
  revisedFromId    String?             @map("revised_from_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User            @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?           @relation("POApprovedBy", fields: [approvedById], references: [id])
  revisedFrom   PurchaseOrder?  @relation("PORevision", fields: [revisedFromId], references: [id], onDelete: SetNull)
  revisions     PurchaseOrder[] @relation("PORevision")
  lineItems     POLineItem[]
  payments      VendorPayment[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, poNumber])
  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([companyId, vendorId])
  @@map("purchase_orders")
}

model POLineItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  /// FROZEN DOCUMENT SNAPSHOT of the material name, in the same spirit as
  /// `ratePaise` below — written once at entry and never recomputed. Renaming
  /// the Material master row does NOT rewrite this, because a purchase order is
  /// a commercial document. Always present, including on rows predating the
  /// material master (materialId = NULL).
  material        String
  /// Canonical material identity for NEW data. NULLABLE and nullable forever:
  /// every PO line written before the material master existed keeps
  /// materialId = NULL and stays completely valid. Never the display source —
  /// `material` above is. ON DELETE SET NULL, so even a hard-deleted master row
  /// only clears the key and leaves the snapshot intact.
  materialId      String? @map("material_id") @db.Uuid
  /// Material category preset (Cement, Steel, …) — powers filters + analytics.
  category        String?
  quantity        Decimal @db.Decimal(12, 3)
  unit            String
  /// Rate snapshot (frozen at entry — never recomputed).
  ratePaise       Int     @map("rate_paise")
  /// GST rate in basis points (1800 = 18%). Integer — no float tax math.
  /// Forward-compat (ADR-0025, not yet implemented): CGST/SGST/IGST split derives
  /// from this single rate (intra-state = CGST+SGST halves, inter-state = IGST);
  /// `hsn_code` and a PO-level tax-inclusive/exclusive flag attach as new columns
  /// with no redesign — `gst_paise` stays the per-line rounded source of truth.
  gstRateBps      Int     @default(0) @map("gst_rate_bps")
  /// GST amount, rounded per line: round(quantity × rate × bps / 10000).
  gstPaise        BigInt  @default(0) @map("gst_paise")
  /// Taxable amount = quantity × rate (ex-GST).
  amountPaise     BigInt  @map("amount_paise")
  sortOrder       Int     @default(0) @map("sort_order")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialRef   Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([materialId])
  @@map("po_line_items")
}

/// A payment made to a vendor. Always project-aware; PO link OPTIONAL
/// (advances / on-account / multi-PO settlements). Outstanding is DERIVED
/// (Σ counted PO grand totals − Σ payments) — never stored.
model VendorPayment {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  vendorId        String      @map("vendor_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  purchaseOrderId String?     @map("purchase_order_id") @db.Uuid
  amountPaise     BigInt      @map("amount_paise")
  paymentMode     PaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  referenceNumber String?     @map("reference_number")
  date            DateTime    @db.Date
  remarks         String?
  /// Client-generated idempotency key. A PARTIAL unique index
  /// (WHERE client_uuid IS NOT NULL) — created in
  /// prisma/migration-payment-idempotency.sql — dedups repeated submissions
  /// without constraining the legacy NULL rows.
  clientUuid      String?     @map("client_uuid")
  createdById     String      @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, vendorId])
  @@index([companyId, projectId])
  @@index([companyId, date])
  @@map("vendor_payments")
}

/// Goods received against a PO. Schema-ready (ADR pending UI) so receiving /
/// GRN can ship later without redesign.
model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  receivedDate    DateTime @map("received_date") @db.Date
  notes           String?
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor        Vendor             @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  createdBy     User               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  items         GoodsReceiptItem[]

  @@index([companyId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String  @id @default(uuid()) @db.Uuid
  goodsReceiptId   String  @map("goods_receipt_id") @db.Uuid
  poLineItemId     String  @map("po_line_item_id") @db.Uuid
  quantityReceived Decimal @map("quantity_received") @db.Decimal(12, 3)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}
