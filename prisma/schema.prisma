// Constructly — Prisma schema
// Module 0: tenant + auth foundation. Module 1: project management.
// Full target model documented in docs/database.md. Tenant isolation is
// enforced by Postgres RLS — see prisma/rls.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PROJECT_MANAGER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRASTRUCTURE
  RENOVATION
  INTERIOR_FITOUT
}

enum ProjectStage {
  CREATED
  PLANNING
  ESTIMATION
  PROCUREMENT
  CONSTRUCTION
  QUALITY_INSPECTION
  COMPLETION
  HANDOVER
  CLOSED
}

enum DocumentCategory {
  DRAWING
  PDF
  PHOTO
  CONTRACT
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

/// A tenant. Every domain row carries companyId.
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  gstin     String?
  /// { poApprovalRequired: boolean, currency: "INR", ... }
  settings  Json     @default("{\"poApprovalRequired\": false, \"currency\": \"INR\"}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  projects            Project[]
  activity            ActivityLog[]
  contractors         Contractor[]
  labourCategories    LabourCategory[]
  labourSubcategories LabourSubcategory[]
  labourAttendance    LabourAttendance[]
  vendors             Vendor[]
  purchaseOrders      PurchaseOrder[]
  vendorPayments      VendorPayment[]
  vendorDocuments     VendorDocument[]
  goodsReceipts       GoodsReceipt[]

  @@map("companies")
}

/// Application user. `id` mirrors the Supabase auth user id.
model User {
  id        String     @id @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  email     String     @unique
  fullName  String     @map("full_name")
  role      Role       @default(PROJECT_MANAGER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdProjects          Project[]         @relation("ProjectCreatedBy")
  managedProjects          Project[]         @relation("ProjectManager")
  favorites                ProjectFavorite[]
  activity                 ActivityLog[]
  createdPurchaseOrders    PurchaseOrder[]   @relation("POCreatedBy")
  approvedPurchaseOrders   PurchaseOrder[]   @relation("POApprovedBy")
  vendorFavorites          VendorFavorite[]
  vendorPayments           VendorPayment[]   @relation("PaymentCreatedBy")
  goodsReceipts            GoodsReceipt[]    @relation("GoodsReceiptCreatedBy")

  @@index([companyId])
  @@map("users")
}

/// A construction project — the spine other modules reference.
model Project {
  id                     String       @id @default(uuid()) @db.Uuid
  companyId              String       @map("company_id") @db.Uuid
  code                   String
  name                   String
  type                   ProjectType
  stage                  ProjectStage @default(CREATED)
  clientName             String?      @map("client_name")
  clientContact          String?      @map("client_contact")
  clientPhone            String?      @map("client_phone")
  clientEmail            String?      @map("client_email")
  siteAddress            String?      @map("site_address")
  gpsLat                 Float?       @map("gps_lat")
  gpsLng                 Float?       @map("gps_lng")
  /// Integer paise (BigInt — budgets can exceed Int32). DTOs expose as number.
  budgetPaise            BigInt       @default(0) @map("budget_paise")
  contractValuePaise     BigInt       @default(0) @map("contract_value_paise")
  /// Dedicated procurement budget (independent of budgetPaise). Null = not set.
  procurementBudgetPaise BigInt?      @map("procurement_budget_paise")
  startDate              DateTime?    @map("start_date") @db.Date
  expectedCompletionDate DateTime?    @map("expected_completion_date") @db.Date
  tags                   String[]     @default([])
  pmId                   String?      @map("pm_id") @db.Uuid
  createdById            String       @map("created_by_id") @db.Uuid
  archivedAt             DateTime?    @map("archived_at")
  deletedAt              DateTime?    @map("deleted_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pm        User?             @relation("ProjectManager", fields: [pmId], references: [id], onDelete: SetNull)
  createdBy User              @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  deadlines        Deadline[]
  documents        ProjectDocument[]
  notes            Note[]
  favorites        ProjectFavorite[]
  labourAttendance LabourAttendance[]
  purchaseOrders   PurchaseOrder[]
  vendorPayments   VendorPayment[]
  goodsReceipts    GoodsReceipt[]

  @@unique([companyId, code])
  @@index([companyId, stage])
  @@index([companyId, pmId])
  @@index([companyId, archivedAt])
  @@map("projects")
}

model Deadline {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  dueDate     DateTime  @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("deadlines")
}

model ProjectDocument {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  category     DocumentCategory @default(OTHER)
  storagePath  String           @map("storage_path")
  filename     String
  sizeBytes    Int              @map("size_bytes")
  mimeType     String           @map("mime_type")
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("project_documents")
}

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  body       String
  authorId   String   @map("author_id") @db.Uuid
  /// Client-generated id for offline idempotency (see lib/sync).
  clientUuid String   @unique @map("client_uuid")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("notes")
}

/// Per-user project pin/favorite.
model ProjectFavorite {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_favorites")
}

/// Immutable audit trail. Feeds the dashboard "Recent activity".
model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    String
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("activity_logs")
}

enum ContractorStatus {
  ACTIVE
  INACTIVE
}

/// Labor contractor. Kept intentionally lean; future modules add payments,
/// invoices, advances, and a ledger as NEW tables referencing contractorId —
/// no redesign of this model required.
model Contractor {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  name      String
  phone     String?
  status    ContractorStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("contractors")
}

/// A labour category (trade group), e.g. Carpenter, Electrician, Mason.
/// Categories contain subcategories; attendance is recorded per subcategory.
model LabourCategory {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  color        String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcategories LabourSubcategory[]

  @@unique([companyId, name])
  @@index([companyId, displayOrder])
  @@map("labour_categories")
}

/// A labour subcategory, e.g. "Main Carpenter" / "Carpenter Helper" under
/// Carpenter. dailyRatePaise is an OPTIONAL day rate used only for estimated
/// labour cost (rate × headcount) — not per-worker tracking.
model LabourSubcategory {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  name           String
  dailyRatePaise Int?     @map("daily_rate_paise")
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   LabourCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attendance LabourAttendance[]

  @@unique([categoryId, name])
  @@index([companyId, categoryId, displayOrder])
  @@map("labour_subcategories")
}

/// Category-based daily attendance: the number of workers present for a
/// labour category on a project + date. Offline-syncable (clientUuid
/// idempotency, clientSeq order); one row per (project, date, category).
/// The category's day rate is SNAPSHOTTED at record time — editing a
/// category's rate later never rewrites historical cost (ADR-0022).
model LabourAttendance {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  projectId              String   @map("project_id") @db.Uuid
  date                   DateTime @db.Date
  labourSubcategoryId    String   @map("labour_subcategory_id") @db.Uuid
  quantityPresent        Int      @map("quantity_present")
  /// Rate snapshot at first recording (null if the subcategory had no rate).
  dailyRatePaiseSnapshot Int?     @map("daily_rate_paise_snapshot")
  /// quantityPresent × dailyRatePaiseSnapshot, stored for immutable history.
  estimatedCostPaise     Int      @default(0) @map("estimated_cost_paise")
  notes                  String?
  clientUuid             String   @unique @map("client_uuid")
  clientSeq              BigInt   @map("client_seq")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcategory LabourSubcategory @relation(fields: [labourSubcategoryId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, labourSubcategoryId])
  @@index([companyId, projectId, date])
  @@index([companyId, date])
  @@map("labour_attendance")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

/// A material supplier. Lean by design; future payments, ledger, credit
/// balances, and GST reports attach as NEW tables referencing vendorId —
/// no redesign of this model required.
model Vendor {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  businessName     String       @map("business_name")
  contactPerson    String?      @map("contact_person")
  phone            String?
  email            String?
  gstin            String?
  pan              String?
  address          String?
  materialsSupplied String[]    @default([]) @map("materials_supplied")
  paymentTerms     String?      @map("payment_terms")
  status           VendorStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  favorites      VendorFavorite[]
  payments       VendorPayment[]
  documents      VendorDocument[]
  goodsReceipts  GoodsReceipt[]

  @@index([companyId, status])
  @@map("vendors")
}

/// A document attached to a vendor (agreements, rate cards, GST certificates).
model VendorDocument {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  vendorId     String           @map("vendor_id") @db.Uuid
  category     DocumentCategory @default(OTHER)
  storagePath  String           @map("storage_path")
  filename     String
  sizeBytes    Int              @map("size_bytes")
  mimeType     String           @map("mime_type")
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([companyId, vendorId])
  @@map("vendor_documents")
}

/// Per-user vendor pin/favorite (optional).
model VendorFavorite {
  userId    String   @map("user_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([userId, vendorId])
  @@map("vendor_favorites")
}

/// A purchase order. Approved POs are immutable — changes go through a
/// "revise" that clones to a new draft linked via revisedFromId (audit trail).
model PurchaseOrder {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  vendorId      String              @map("vendor_id") @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  poNumber      String              @map("po_number")
  status        PurchaseOrderStatus @default(DRAFT)
  invoiceNumber String?             @map("invoice_number")
  purchaseDate  DateTime            @map("purchase_date") @db.Date
  expectedDelivery DateTime?        @map("expected_delivery") @db.Date
  notes         String?
  /// Denormalized Σ line taxable amounts (integer paise, ex-GST).
  subtotalPaise BigInt              @default(0) @map("subtotal_paise")
  /// Denormalized Σ line GST (integer paise).
  gstPaise      BigInt              @default(0) @map("gst_paise")
  /// Grand total = subtotal + GST (integer paise). Budget math uses this.
  totalPaise    BigInt              @default(0) @map("total_paise")
  createdById   String              @map("created_by_id") @db.Uuid
  approvedById  String?             @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?           @map("approved_at")
  revisedFromId String?             @map("revised_from_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor      Vendor         @relation(fields: [vendorId], references: [id])
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?          @relation("POApprovedBy", fields: [approvedById], references: [id])
  revisedFrom PurchaseOrder? @relation("PORevision", fields: [revisedFromId], references: [id])
  revisions   PurchaseOrder[] @relation("PORevision")
  lineItems   POLineItem[]
  payments    VendorPayment[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, poNumber])
  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([companyId, vendorId])
  @@map("purchase_orders")
}

model POLineItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  material        String
  /// Material category preset (Cement, Steel, …) — powers filters + analytics.
  category        String?
  quantity        Decimal @db.Decimal(12, 3)
  unit            String
  /// Rate snapshot (frozen at entry — never recomputed).
  ratePaise       Int     @map("rate_paise")
  /// GST rate in basis points (1800 = 18%). Integer — no float tax math.
  /// Forward-compat (ADR-0025, not yet implemented): CGST/SGST/IGST split derives
  /// from this single rate (intra-state = CGST+SGST halves, inter-state = IGST);
  /// `hsn_code` and a PO-level tax-inclusive/exclusive flag attach as new columns
  /// with no redesign — `gst_paise` stays the per-line rounded source of truth.
  gstRateBps      Int     @default(0) @map("gst_rate_bps")
  /// GST amount, rounded per line: round(quantity × rate × bps / 10000).
  gstPaise        BigInt  @default(0) @map("gst_paise")
  /// Taxable amount = quantity × rate (ex-GST).
  amountPaise     BigInt  @map("amount_paise")
  sortOrder       Int     @default(0) @map("sort_order")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("po_line_items")
}

/// A payment made to a vendor. Always project-aware; PO link OPTIONAL
/// (advances / on-account / multi-PO settlements). Outstanding is DERIVED
/// (Σ counted PO grand totals − Σ payments) — never stored.
model VendorPayment {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  vendorId        String      @map("vendor_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  purchaseOrderId String?     @map("purchase_order_id") @db.Uuid
  amountPaise     BigInt      @map("amount_paise")
  paymentMode     PaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  referenceNumber String?     @map("reference_number")
  date            DateTime    @db.Date
  remarks         String?
  /// Client-generated idempotency key. A PARTIAL unique index
  /// (WHERE client_uuid IS NOT NULL) — created in
  /// prisma/migration-payment-idempotency.sql — dedups repeated submissions
  /// without constraining the legacy NULL rows.
  clientUuid      String?     @map("client_uuid")
  createdById     String      @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, vendorId])
  @@index([companyId, projectId])
  @@index([companyId, date])
  @@map("vendor_payments")
}

/// Goods received against a PO. Schema-ready (ADR pending UI) so receiving /
/// GRN can ship later without redesign.
model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  receivedDate    DateTime @map("received_date") @db.Date
  notes           String?
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor        Vendor             @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  createdBy     User               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  items         GoodsReceiptItem[]

  @@index([companyId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String  @id @default(uuid()) @db.Uuid
  goodsReceiptId String  @map("goods_receipt_id") @db.Uuid
  poLineItemId   String  @map("po_line_item_id") @db.Uuid
  quantityReceived Decimal @map("quantity_received") @db.Decimal(12, 3)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}
