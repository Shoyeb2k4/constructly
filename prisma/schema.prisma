// Constructly — Prisma schema
// Module 0: tenant + auth foundation. Module 1: project management.
// Full target model documented in docs/database.md. Tenant isolation is
// enforced by Postgres RLS — see prisma/rls.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PROJECT_MANAGER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRASTRUCTURE
  RENOVATION
  INTERIOR_FITOUT
}

enum ProjectStage {
  CREATED
  PLANNING
  ESTIMATION
  PROCUREMENT
  CONSTRUCTION
  QUALITY_INSPECTION
  COMPLETION
  HANDOVER
  CLOSED
}

enum DocumentCategory {
  DRAWING
  PDF
  PHOTO
  CONTRACT
  OTHER
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

/// A tenant. Every domain row carries companyId.
model Company {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  gstin    String?
  /// { poApprovalRequired: boolean, currency: "INR", ... }
  settings Json    @default("{\"poApprovalRequired\": false, \"currency\": \"INR\"}")

  // ── Company profile (white-labeling). All nullable — companies without
  //    branding fall back to Constructly defaults (see features/branding). ──
  legalName   String? @map("legal_name")
  pan         String?
  cin         String?
  addressLine String? @map("address_line")
  city        String?
  state       String?
  country     String? @default("India")
  pincode     String?
  phone       String?
  email       String?
  website     String?

  // ── Branding assets: Supabase Storage object paths ("{companyId}/…"). ──
  logoPath       String? @map("logo_path")
  squareLogoPath String? @map("square_logo_path")
  darkLogoPath   String? @map("dark_logo_path")
  lightLogoPath  String? @map("light_logo_path")
  faviconPath    String? @map("favicon_path")
  stampPath      String? @map("stamp_path")
  /// { primary, secondary, accent, success, warning, danger } hex strings.
  brandColors    Json?   @map("brand_colors")

  /// Retention window (days) after which a soft-deleted project becomes
  /// ELIGIBLE for admin/scheduled permanent cleanup. null = keep indefinitely
  /// (never auto-eligible). Nothing is ever hard-deleted automatically; this
  /// only marks eligibility for a reviewed, admin-only purge. See
  /// features/projects/retention.ts.
  projectRetentionDays Int? @map("project_retention_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                        User[]
  roles                        CompanyRole[]
  userRoles                    UserRole[]
  invitations                  Invitation[]
  projects                     Project[]
  activity                     ActivityLog[]
  contractors                  Contractor[]
  contractorLedger             ContractorLedgerEntry[]
  contractorSettlements        ContractorSettlement[]
  labourCategories             LabourCategory[]
  labourSubcategories          LabourSubcategory[]
  labourAttendance             LabourAttendance[]
  vendors                      Vendor[]
  purchaseOrders               PurchaseOrder[]
  vendorPayments               VendorPayment[]
  vendorDocuments              VendorDocument[]
  goodsReceipts                GoodsReceipt[]
  contractorAssignments        ProjectContractorAssignment[]
  projectContractors           ProjectContractor[]
  projectContractorLabourRates ProjectContractorLabourRate[]

  @@map("companies")
}

/// Application user. `id` mirrors the Supabase auth user id.
model User {
  id            String     @id @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  email         String     @unique
  fullName      String     @map("full_name")
  /// Legacy role enum — still authoritative for authorization in Phase 1. The
  /// RBAC layer (companyRole) runs alongside it until the Phase 2 enforcement
  /// swap. Do NOT drop this column until every check reads permissions instead.
  role          Role       @default(PROJECT_MANAGER)
  status        UserStatus @default(ACTIVE)
  /// RBAC: the data-driven company role assigned to this user (nullable during
  /// migration; the session falls back to `role` when unset).
  companyRoleId String?    @map("role_id") @db.Uuid

  // ── Personal profile (all nullable; sensible defaults applied in app). ──
  designation   String?
  phone         String?
  photoPath     String? @map("photo_path")
  signaturePath String? @map("signature_path")
  theme         String? @default("system")
  language      String? @default("en")
  timezone      String? @default("Asia/Kolkata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company                Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdProjects        Project[]         @relation("ProjectCreatedBy")
  managedProjects        Project[]         @relation("ProjectManager")
  deletedProjects        Project[]         @relation("ProjectDeletedBy")
  favorites              ProjectFavorite[]
  activity               ActivityLog[]
  createdPurchaseOrders  PurchaseOrder[]   @relation("POCreatedBy")
  approvedPurchaseOrders PurchaseOrder[]   @relation("POApprovedBy")
  vendorFavorites        VendorFavorite[]
  vendorPayments         VendorPayment[]   @relation("PaymentCreatedBy")
  goodsReceipts          GoodsReceipt[]    @relation("GoodsReceiptCreatedBy")
  sentInvitations        Invitation[]      @relation("InvitationInvitedBy")
  companyRole            CompanyRole?      @relation("UserCompanyRole", fields: [companyRoleId], references: [id], onDelete: SetNull)
  roleAssignments        UserRole[]        @relation("UserRoleMember")
  rolesAssignedByMe      UserRole[]        @relation("UserRoleAssignedBy")
  deletedLabourCategories    LabourCategory[]    @relation("LabourCategoryDeletedBy")
  deletedLabourSubcategories LabourSubcategory[] @relation("LabourSubcategoryDeletedBy")

  @@index([companyId])
  @@index([companyRoleId])
  @@map("users")
}

/// RBAC role — a named, per-company collection of permission keys (see
/// features/rbac/permissions.ts). Roles are DATA, not code: each company owns
/// its own set, seeded from SYSTEM_ROLES and extensible with custom roles.
/// `isOwner` marks the protected all-access role (implicit every permission).
model CompanyRole {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// Stable identifier for a seeded system role ("owner", "admin", …); null for
  /// custom roles. Unique per company (partial index — see migration).
  key         String?
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isOwner     Boolean  @default(false) @map("is_owner")
  /// Permission keys granted by this role. Supports concrete keys and wildcards
  /// ("*", "projects.*"), expanded at resolve time. Ignored for the owner role,
  /// whose access is implicit. The code catalog is authoritative for valid keys.
  permissions String[] @default([])
  /// Optional parent role to inherit permissions from (role hierarchy). Null =
  /// no parent. Schema-ready for Phase 4; resolution flattening lands with it.
  parentId    String?  @map("parent_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      CompanyRole?  @relation("RoleInheritance", fields: [parentId], references: [id], onDelete: SetNull)
  children    CompanyRole[] @relation("RoleInheritance")
  users       User[]        @relation("UserCompanyRole")
  assignments UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentId])
  @@map("roles")
}

/// User↔role junction — the authoritative record of which roles a user holds.
/// Today every user has exactly one row (mirroring the primary role), but the
/// many-to-many shape means multiple roles per user need NO future migration:
/// the session simply unions permissions across all rows. `isPrimary` marks the
/// user's default/primary role (also denormalised on User.companyRoleId).
model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  isPrimary    Boolean  @default(false) @map("is_primary")
  /// Who assigned this role (audit provenance); null for system/seed assignment.
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User        @relation("UserRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  role       CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User?       @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([companyId])
  @@index([roleId])
  @@map("user_roles")
}

/// A pending/accepted email invitation to join a company with a given role.
/// Backed by a Supabase auth invite; the app user row is created on accept.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  email       String
  role        Role             @default(PROJECT_MANAGER)
  status      InvitationStatus @default(PENDING)
  /// The Supabase auth user created by the invite (for cleanup on cancel).
  authUserId  String?          @map("auth_user_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  acceptedAt  DateTime?        @map("accepted_at")
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([companyId, status])
  @@index([email])
  @@map("invitations")
}

/// A construction project — the spine other modules reference.
model Project {
  id                     String       @id @default(uuid()) @db.Uuid
  companyId              String       @map("company_id") @db.Uuid
  code                   String
  name                   String
  type                   ProjectType
  stage                  ProjectStage @default(CREATED)
  clientName             String?      @map("client_name")
  clientContact          String?      @map("client_contact")
  clientPhone            String?      @map("client_phone")
  clientEmail            String?      @map("client_email")
  siteAddress            String?      @map("site_address")
  gpsLat                 Float?       @map("gps_lat")
  gpsLng                 Float?       @map("gps_lng")
  /// Integer paise (BigInt — budgets can exceed Int32). DTOs expose as number.
  budgetPaise            BigInt       @default(0) @map("budget_paise")
  contractValuePaise     BigInt       @default(0) @map("contract_value_paise")
  /// Dedicated procurement budget (independent of budgetPaise). Null = not set.
  procurementBudgetPaise BigInt?      @map("procurement_budget_paise")
  startDate              DateTime?    @map("start_date") @db.Date
  expectedCompletionDate DateTime?    @map("expected_completion_date") @db.Date
  tags                   String[]     @default([])
  pmId                   String?      @map("pm_id") @db.Uuid
  createdById            String       @map("created_by_id") @db.Uuid
  archivedAt             DateTime?    @map("archived_at")
  deletedAt              DateTime?    @map("deleted_at")
  /// Who soft-deleted the project and why (audit/recovery). Null unless deleted.
  deletedById            String?      @map("deleted_by_id") @db.Uuid
  deletedReason          String?      @map("deleted_reason")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  company               Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pm                    User?                         @relation("ProjectManager", fields: [pmId], references: [id], onDelete: SetNull)
  createdBy             User                          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  deletedBy             User?                         @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deadlines             Deadline[]
  documents             ProjectDocument[]
  notes                 Note[]
  favorites             ProjectFavorite[]
  labourAttendance      LabourAttendance[]
  purchaseOrders        PurchaseOrder[]
  vendorPayments        VendorPayment[]
  goodsReceipts         GoodsReceipt[]
  contractorSettlements ContractorSettlement[]
  contractorAssignments ProjectContractorAssignment[]
  projectContractors    ProjectContractor[]

  @@unique([companyId, code])
  @@index([companyId, stage])
  @@index([companyId, pmId])
  @@index([companyId, archivedAt])
  @@map("projects")
}

model Deadline {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  dueDate     DateTime  @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("deadlines")
}

model ProjectDocument {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  projectId    String           @map("project_id") @db.Uuid
  category     DocumentCategory @default(OTHER)
  storagePath  String           @map("storage_path")
  filename     String
  sizeBytes    Int              @map("size_bytes")
  mimeType     String           @map("mime_type")
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("project_documents")
}

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  body       String
  authorId   String   @map("author_id") @db.Uuid
  /// Client-generated id for offline idempotency (see lib/sync).
  clientUuid String   @unique @map("client_uuid")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("notes")
}

/// Per-user project pin/favorite.
model ProjectFavorite {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_favorites")
}

/// Immutable audit trail. Feeds the dashboard "Recent activity".
model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    String
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("activity_logs")
}

enum ContractorStatus {
  ACTIVE
  INACTIVE
}

/// Labor contractor. Kept intentionally lean; future modules add payments,
/// invoices, advances, and a ledger as NEW tables referencing contractorId —
/// no redesign of this model required.
model Contractor {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @map("company_id") @db.Uuid
  name                String
  phone               String?
  status              ContractorStatus @default(ACTIVE)
  /// Opening advance carried in at contractor creation (integer paise). Seeds
  /// the first ledger entry; the ledger is the authoritative running balance.
  openingAdvancePaise Int              @default(0) @map("opening_advance_paise")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger             ContractorLedgerEntry[]
  settlements        ContractorSettlement[]
  attendance         LabourAttendance[]
  assignments        ProjectContractorAssignment[]
  projectContractors ProjectContractor[]

  @@index([companyId, status])
  @@map("contractors")
}

/// Kinds of contractor ledger movements. Sign convention for the advance
/// balance: OPENING_ADVANCE / ADVANCE increase it; ADJUSTMENT decreases it;
/// LABOUR_BILL and PAYMENT are informational (no advance-balance effect).
enum ContractorLedgerType {
  OPENING_ADVANCE
  ADVANCE
  LABOUR_BILL
  ADJUSTMENT
  PAYMENT
}

/// Append-only, immutable contractor ledger. Each entry snapshots the advance
/// balance AFTER it, so history never needs recomputation (ADR: financial
/// integrity). Advances and adjustments are company/contractor-scoped; labour
/// bills and payments arise from a settlement (see settlementId).
model ContractorLedgerEntry {
  id                       String               @id @default(uuid()) @db.Uuid
  companyId                String               @map("company_id") @db.Uuid
  contractorId             String               @map("contractor_id") @db.Uuid
  date                     DateTime             @db.Date
  type                     ContractorLedgerType
  /// Unsigned magnitude in paise; the sign is implied by `type`.
  amountPaise              Int                  @map("amount_paise")
  /// Running advance balance immediately after this entry (integer paise).
  advanceBalanceAfterPaise Int                  @map("advance_balance_after_paise")
  notes                    String?
  settlementId             String?              @map("settlement_id") @db.Uuid
  createdById              String               @map("created_by_id") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor Contractor            @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  settlement ContractorSettlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([companyId, contractorId, createdAt])
  @@index([companyId, settlementId])
  @@map("contractor_ledger_entries")
}

/// A weekly contractor settlement for one project + period. Snapshots the
/// computed labour bill, the advance adjustment applied, the resulting net
/// cash payment, and the advance balance afterwards. Immutable once created;
/// it emits LABOUR_BILL, (optional) ADJUSTMENT, and PAYMENT ledger entries.
model ContractorSettlement {
  id                       String   @id @default(uuid()) @db.Uuid
  companyId                String   @map("company_id") @db.Uuid
  contractorId             String   @map("contractor_id") @db.Uuid
  projectId                String   @map("project_id") @db.Uuid
  periodStart              DateTime @map("period_start") @db.Date
  periodEnd                DateTime @map("period_end") @db.Date
  /// Σ estimated labour cost for this contractor on this project in the period.
  labourBillPaise          Int      @map("labour_bill_paise")
  /// Advance drawn down against the bill (≤ min(outstanding advance, bill)).
  advanceAdjustmentPaise   Int      @default(0) @map("advance_adjustment_paise")
  /// Net cash paid = labourBill − advanceAdjustment.
  netPaymentPaise          Int      @map("net_payment_paise")
  /// Contractor advance balance after this settlement (integer paise).
  advanceBalanceAfterPaise Int      @map("advance_balance_after_paise")
  notes                    String?
  createdById              String   @map("created_by_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractor Contractor              @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ledger     ContractorLedgerEntry[]

  @@index([companyId, contractorId, createdAt])
  @@index([companyId, projectId])
  @@map("contractor_settlements")
}

/// A labour category (trade group), e.g. Carpenter, Electrician, Mason.
/// Categories contain subcategories; attendance is recorded per subcategory.
model LabourCategory {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  color        String?
  displayOrder Int      @default(0) @map("display_order")
  /// Owner Force Delete soft-deletes (deactivates) a group: `deletedAt` set, the
  /// row hidden from all master data / config / pickers, but KEPT so historical
  /// attendance still resolves its name (never a physical delete — see
  /// features/labor/server/actions.ts forceDeleteCategory). deletedById records
  /// the acting Owner.
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company       Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deletedBy     User?                         @relation("LabourCategoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  subcategories LabourSubcategory[]
  assignments   ProjectContractorAssignment[]

  // Name uniqueness is enforced by a PARTIAL unique index (WHERE deleted_at IS
  // NULL) so a name freed by a soft-delete can be reused — see
  // prisma/migration-labour-force-delete.sql. Prisma can't express partial
  // unique, so the compile-time @@unique is intentionally omitted here.
  @@index([companyId, displayOrder])
  @@index([companyId, deletedAt])
  @@map("labour_categories")
}

/// A labour subcategory, e.g. "Main Carpenter" / "Carpenter Helper" under
/// Carpenter. dailyRatePaise is an OPTIONAL day rate used only for estimated
/// labour cost (rate × headcount) — not per-worker tracking.
model LabourSubcategory {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  name           String
  dailyRatePaise Int?     @map("daily_rate_paise")
  displayOrder   Int      @default(0) @map("display_order")
  /// Owner Force Delete soft-deletes (deactivates) a labour type: `deletedAt`
  /// set, the row hidden from master data / config / pickers but KEPT so
  /// historical attendance still resolves its name. See forceDeleteSubcategory.
  deletedAt      DateTime? @map("deleted_at")
  deletedById    String?   @map("deleted_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company                Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category               LabourCategory                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  deletedBy              User?                         @relation("LabourSubcategoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  attendance             LabourAttendance[]
  projectContractorRates ProjectContractorLabourRate[]

  // Name uniqueness within a group is a PARTIAL unique index (WHERE deleted_at
  // IS NULL) — see prisma/migration-labour-force-delete.sql. Compile-time
  // @@unique intentionally omitted (Prisma can't express partial unique).
  @@index([companyId, categoryId, displayOrder])
  @@index([companyId, deletedAt])
  @@map("labour_subcategories")
}

/// Which contractor handles which work category on a given project (the
/// client's "Pappu → Civil, Shoeb → Tiles"). A project may have many rows; a
/// contractor may serve many projects with different categories. This is an
/// ELIGIBILITY/CONFIG layer only — it never touches the immutable contractor
/// ledger. Reuses the existing LabourCategory taxonomy (no parallel system).
/// Labour attendance restricts its contractor options to these rows and
/// attributes each category group to the contractor assigned to it here.
model ProjectContractorAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  contractorId     String   @map("contractor_id") @db.Uuid
  labourCategoryId String   @map("labour_category_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  category   LabourCategory @relation(fields: [labourCategoryId], references: [id], onDelete: Cascade)

  @@unique([projectId, contractorId, labourCategoryId])
  @@index([companyId, projectId])
  @@index([companyId, contractorId])
  @@map("project_contractor_assignments")
}

/// A contractor engaged on a project (the client's "Anjali → Pappu, Saddam").
/// The CONTRACTOR is the top-level grouping the Labour module presents; the
/// labour types they supply on this project (with per-type rates) hang off this
/// row via ProjectContractorLabourRate. `contractRatePaise`/`contractRateUnit`
/// hold an OPTIONAL project-level agreement figure (e.g. ₹240/sq.ft) — a
/// DIFFERENT concept from labour day-rates: display/store only, never fed into
/// daily attendance or settlement. Supersedes ProjectContractorAssignment.
model ProjectContractor {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  contractorId      String   @map("contractor_id") @db.Uuid
  /// Optional project agreement rate (integer paise). Not used for attendance.
  contractRatePaise Int?     @map("contract_rate_paise")
  /// Unit for the agreement rate: "sqft" | "lumpsum" | … (free text). Null when
  /// no agreement rate is set.
  contractRateUnit  String?  @map("contract_rate_unit")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company     Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor  Contractor                    @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  labourRates ProjectContractorLabourRate[]

  @@unique([projectId, contractorId])
  @@index([companyId, projectId])
  @@index([companyId, contractorId])
  @@map("project_contractors")
}

/// Which labour types a contractor supplies on a project, and the PROJECT-
/// SPECIFIC day rate for each. Reuses the LabourSubcategory taxonomy (Mason,
/// Helper, Centering, …) — the same subcategory can appear under multiple
/// contractors on one project (Pappu-Centering ₹850 and Saddam-Centering ₹950
/// coexist). Attendance snapshots ratePaise at record time; editing it later
/// never rewrites history (attendance keeps its own snapshot).
model ProjectContractorLabourRate {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  projectContractorId String   @map("project_contractor_id") @db.Uuid
  labourSubcategoryId String   @map("labour_subcategory_id") @db.Uuid
  /// Project-specific day rate (integer paise).
  ratePaise           Int      @map("rate_paise")
  rateUnit            String   @default("day") @map("rate_unit")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectContractor ProjectContractor  @relation(fields: [projectContractorId], references: [id], onDelete: Cascade)
  subcategory       LabourSubcategory  @relation(fields: [labourSubcategoryId], references: [id], onDelete: Cascade)
  attendance        LabourAttendance[]

  @@unique([projectContractorId, labourSubcategoryId])
  @@index([companyId, projectContractorId])
  @@index([companyId, labourSubcategoryId])
  @@map("project_contractor_labour_rates")
}

/// Contractor-first daily attendance: the number of workers present for a
/// labour subcategory on a project + date, ATTRIBUTED TO A CONTRACTOR.
/// Offline-syncable (clientUuid idempotency, clientSeq order). Identity is
/// (project, date, subcategory, contractor) — enforced in SQL as a
/// UNIQUE … NULLS NOT DISTINCT index so two contractors can supply the same
/// subcategory on the same project/date (Pappu-Centering + Saddam-Centering)
/// while legacy null-contractor rows keep one-row-per-triple semantics.
/// The effective day rate (project + contractor + subcategory, falling back to
/// the subcategory's global rate) is SNAPSHOTTED at record time — editing a
/// rate later never rewrites historical cost (ADR-0022).
model LabourAttendance {
  id                            String   @id @default(uuid()) @db.Uuid
  companyId                     String   @map("company_id") @db.Uuid
  projectId                     String   @map("project_id") @db.Uuid
  date                          DateTime @db.Date
  labourSubcategoryId           String   @map("labour_subcategory_id") @db.Uuid
  /// Optional contractor this labour is attributed to. Nullable: legacy rows
  /// and unattributed labour have none; a contractor's weekly bill sums the
  /// estimatedCostPaise of their attributed rows in the period.
  contractorId                  String?  @map("contractor_id") @db.Uuid
  /// Provenance of the snapshotted rate: the ProjectContractorLabourRate the
  /// rate came from. Null when the rate fell back to the subcategory's global
  /// rate, or for legacy rows. SetNull on delete so history survives config edits.
  projectContractorLabourRateId String?  @map("project_contractor_labour_rate_id") @db.Uuid
  /// Headcount present. Float to allow half-day (0.5) increments; 0.5 steps
  /// are exactly representable, and legacy whole-number rows are unaffected.
  quantityPresent               Float    @map("quantity_present")
  /// Rate snapshot at first recording (null if no rate resolved).
  dailyRatePaiseSnapshot        Int?     @map("daily_rate_paise_snapshot")
  /// quantityPresent × dailyRatePaiseSnapshot, stored for immutable history.
  estimatedCostPaise            Int      @default(0) @map("estimated_cost_paise")
  notes                         String?
  clientUuid                    String   @unique @map("client_uuid")
  clientSeq                     BigInt   @map("client_seq")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  company     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcategory LabourSubcategory            @relation(fields: [labourSubcategoryId], references: [id], onDelete: Cascade)
  contractor  Contractor?                  @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  rate        ProjectContractorLabourRate? @relation(fields: [projectContractorLabourRateId], references: [id], onDelete: SetNull)

  // Identity = (project, date, subcategory, contractor). The DB enforces this as
  // UNIQUE … NULLS NOT DISTINCT (see prisma/migration-attendance-contractor-
  // identity.sql) so the legacy contractorId-NULL rows keep
  // one-row-per-(project,date,subcategory). Prisma has no schema syntax for
  // NULLS NOT DISTINCT, and the compound-unique accessor it generates
  // (projectId_date_labourSubcategoryId_contractorId) types contractorId as
  // NON-null — so it CANNOT target a NULL-contractor row. The write paths
  // therefore never use that accessor: setQuantity / applyLabourAttendance /
  // copyPreviousDay do findFirst (nullable-safe) → update-by-id or create, and
  // clears use deleteMany (WHERE contractor_id IS NULL). The DB unique index is
  // the concurrency backstop; a rare race surfaces as a create error that the
  // interactive path reports and the offline outbox retries into an update.
  @@unique([projectId, date, labourSubcategoryId, contractorId])
  @@index([companyId, contractorId, date])
  @@index([companyId, projectId, date])
  @@index([companyId, date])
  @@map("labour_attendance")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

/// A material supplier. Lean by design; future payments, ledger, credit
/// balances, and GST reports attach as NEW tables referencing vendorId —
/// no redesign of this model required.
model Vendor {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  businessName      String       @map("business_name")
  contactPerson     String?      @map("contact_person")
  phone             String?
  email             String?
  gstin             String?
  pan               String?
  address           String?
  materialsSupplied String[]     @default([]) @map("materials_supplied")
  paymentTerms      String?      @map("payment_terms")
  status            VendorStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  favorites      VendorFavorite[]
  payments       VendorPayment[]
  documents      VendorDocument[]
  goodsReceipts  GoodsReceipt[]

  @@index([companyId, status])
  @@map("vendors")
}

/// A document attached to a vendor (agreements, rate cards, GST certificates).
model VendorDocument {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  vendorId     String           @map("vendor_id") @db.Uuid
  category     DocumentCategory @default(OTHER)
  storagePath  String           @map("storage_path")
  filename     String
  sizeBytes    Int              @map("size_bytes")
  mimeType     String           @map("mime_type")
  uploadedById String           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([companyId, vendorId])
  @@map("vendor_documents")
}

/// Per-user vendor pin/favorite (optional).
model VendorFavorite {
  userId    String   @map("user_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([userId, vendorId])
  @@map("vendor_favorites")
}

/// A purchase order. Approved POs are immutable — changes go through a
/// "revise" that clones to a new draft linked via revisedFromId (audit trail).
model PurchaseOrder {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  vendorId         String              @map("vendor_id") @db.Uuid
  projectId        String              @map("project_id") @db.Uuid
  poNumber         String              @map("po_number")
  status           PurchaseOrderStatus @default(DRAFT)
  invoiceNumber    String?             @map("invoice_number")
  purchaseDate     DateTime            @map("purchase_date") @db.Date
  expectedDelivery DateTime?           @map("expected_delivery") @db.Date
  notes            String?
  /// Denormalized Σ line taxable amounts (integer paise, ex-GST).
  subtotalPaise    BigInt              @default(0) @map("subtotal_paise")
  /// Denormalized Σ line GST (integer paise).
  gstPaise         BigInt              @default(0) @map("gst_paise")
  /// Grand total = subtotal + GST (integer paise). Budget math uses this.
  totalPaise       BigInt              @default(0) @map("total_paise")
  createdById      String              @map("created_by_id") @db.Uuid
  approvedById     String?             @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?           @map("approved_at")
  revisedFromId    String?             @map("revised_from_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User            @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?           @relation("POApprovedBy", fields: [approvedById], references: [id])
  revisedFrom   PurchaseOrder?  @relation("PORevision", fields: [revisedFromId], references: [id], onDelete: SetNull)
  revisions     PurchaseOrder[] @relation("PORevision")
  lineItems     POLineItem[]
  payments      VendorPayment[]
  goodsReceipts GoodsReceipt[]

  @@unique([companyId, poNumber])
  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([companyId, vendorId])
  @@map("purchase_orders")
}

model POLineItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  material        String
  /// Material category preset (Cement, Steel, …) — powers filters + analytics.
  category        String?
  quantity        Decimal @db.Decimal(12, 3)
  unit            String
  /// Rate snapshot (frozen at entry — never recomputed).
  ratePaise       Int     @map("rate_paise")
  /// GST rate in basis points (1800 = 18%). Integer — no float tax math.
  /// Forward-compat (ADR-0025, not yet implemented): CGST/SGST/IGST split derives
  /// from this single rate (intra-state = CGST+SGST halves, inter-state = IGST);
  /// `hsn_code` and a PO-level tax-inclusive/exclusive flag attach as new columns
  /// with no redesign — `gst_paise` stays the per-line rounded source of truth.
  gstRateBps      Int     @default(0) @map("gst_rate_bps")
  /// GST amount, rounded per line: round(quantity × rate × bps / 10000).
  gstPaise        BigInt  @default(0) @map("gst_paise")
  /// Taxable amount = quantity × rate (ex-GST).
  amountPaise     BigInt  @map("amount_paise")
  sortOrder       Int     @default(0) @map("sort_order")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("po_line_items")
}

/// A payment made to a vendor. Always project-aware; PO link OPTIONAL
/// (advances / on-account / multi-PO settlements). Outstanding is DERIVED
/// (Σ counted PO grand totals − Σ payments) — never stored.
model VendorPayment {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  vendorId        String      @map("vendor_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  purchaseOrderId String?     @map("purchase_order_id") @db.Uuid
  amountPaise     BigInt      @map("amount_paise")
  paymentMode     PaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  referenceNumber String?     @map("reference_number")
  date            DateTime    @db.Date
  remarks         String?
  /// Client-generated idempotency key. A PARTIAL unique index
  /// (WHERE client_uuid IS NOT NULL) — created in
  /// prisma/migration-payment-idempotency.sql — dedups repeated submissions
  /// without constraining the legacy NULL rows.
  clientUuid      String?     @map("client_uuid")
  createdById     String      @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, vendorId])
  @@index([companyId, projectId])
  @@index([companyId, date])
  @@map("vendor_payments")
}

/// Goods received against a PO. Schema-ready (ADR pending UI) so receiving /
/// GRN can ship later without redesign.
model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  receivedDate    DateTime @map("received_date") @db.Date
  notes           String?
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor        Vendor             @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  createdBy     User               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  items         GoodsReceiptItem[]

  @@index([companyId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String  @id @default(uuid()) @db.Uuid
  goodsReceiptId   String  @map("goods_receipt_id") @db.Uuid
  poLineItemId     String  @map("po_line_item_id") @db.Uuid
  quantityReceived Decimal @map("quantity_received") @db.Decimal(12, 3)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}
