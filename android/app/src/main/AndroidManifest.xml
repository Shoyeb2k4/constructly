<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                OAuth return leg.

                Google blocks OAuth in embedded WebViews, so the authorization
                page opens in a Custom Tab. Supabase performs the Google code
                exchange and then redirects to our custom scheme, which is what
                this filter catches and hands to `parseAuthCallback`.

                The scheme is `@string/custom_url_scheme`, generated by Capacitor
                from `appId` in capacitor.config.ts — so the manifest, the
                Info.plist on iOS and `MOBILE_URL_SCHEME` in
                src/lib/mobile/auth-callback.ts cannot drift apart.

                `launchMode="singleTask"` above means the return arrives at the
                EXISTING activity via onNewIntent, so the PKCE verifier created
                before the browser opened is still in memory. A new task would
                lose it and every Google sign-in would fail.

                Scoped to host `auth` + path `/callback` deliberately: a bare
                scheme filter would let any `in.co.constructly.app://…` link
                reach the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="@string/custom_url_scheme"
                    android:host="auth"
                    android:path="/callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
