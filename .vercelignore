# Never upload local env files to the Vercel build — runtime uses the
# dashboard environment variables. (Runtime is already secure; this keeps
# secrets out of the build container entirely.)
.env
.env.*
!.env.example

# Local-only / not needed for the build
.git
tests
playwright-report
test-results
*.log
scratchpad

# Native iOS app. The Vercel build produces the WEB app only; the Capacitor
# project and the mobile SPA are built by the macOS CI runner instead. Excluded
# so nothing here can affect (or slow) a production web deploy.
ios
mobile
