{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "constructly",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "constructly-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "constructly-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:demo"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "constructly-demo-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:demo"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
